---
// AdminSidebar — navegación fija del panel admin (ver `sdd/admin-dashboard`,
// design D6 + spec "Admin sidebar navigation"). Renderiza `ADMIN_NAV`
// (fuente única, `nav.ts`) y marca el ítem activo por `Astro.url.pathname`.
// Los ítems `soon` son links reales con un badge atenuado — nunca
// `aria-disabled` ni un `#` muerto (spec "Placeholder item is visually
// marked").
//
// Toggle mobile: checkbox + `:has()`, visualmente sin JS de cliente. PERO
// `AdminShell.astro` persiste este componente entero (`transition:persist`,
// crítica `/impeccable` P2 "ClientRouter desvanece todo el shell") para que
// sidebar/header no se desvanezcan en cada navegación SPA — el mismo nodo
// (checkbox incluido, y el `data-active` de cada link, calculado en el
// servidor por request) sobrevive entre páginas en vez de recrearse. Sin
// re-sincronizar a mano, el ítem activo queda congelado en la primera
// carga y el drawer mobile no se cierra solo al navegar (crítica P0
// "sidebar activo se congela") — de ahí el `<script>` al final del archivo,
// enganchado a `astro:page-load` (dispara en la carga inicial Y en cada
// navegación SPA, mismo patrón que `ParticipantsBrowser.astro`).
import { ADMIN_NAV } from '@admin/components/nav';
import BrandIsotypeMono from '@admin/components/BrandIsotypeMono.astro';

const currentPath = Astro.url.pathname;
---

<aside class="sidebar">
  <div class="topbar">
    <div class="brand">
      <BrandIsotypeMono class="brand-icon" />
      <span class="wordmark">FINISH LINE</span>
    </div>

    <input type="checkbox" id="admin-nav-toggle" class="nav-toggle-input" aria-label="Abrir menú de navegación" />
    <label for="admin-nav-toggle" class="nav-toggle">
      <span class="nav-toggle-icon" aria-hidden="true"></span>
    </label>
  </div>

  {/* Fondo del drawer mobile — es un <label> del mismo checkbox: clickearlo
      afuera del panel lo cierra sin JS. Invisible/inerte en desktop. */}
  <label for="admin-nav-toggle" class="nav-backdrop" aria-hidden="true"></label>

  <div class="collapsible">
    <nav class="nav" aria-label="Navegación del panel">
      <ul class="nav-list">
        {
          ADMIN_NAV.map((item) => {
            const isActive = item.href === '/admin' ? currentPath === '/admin' : currentPath.startsWith(item.href);
            return (
              <li>
                <a href={item.href} class="nav-item" data-active={isActive} data-soon={item.status === 'soon'}>
                  <span class="label">{item.label}</span>
                  {item.status === 'soon' && <span class="badge">Próximamente</span>}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="footer">
      <slot name="footer" />
    </div>
  </div>
</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    width: 240px;
    flex-shrink: 0;
    min-height: 100dvh;
    background: var(--adm-surface);
    border-right: 1px solid var(--adm-border);
    padding: 20px 16px;
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 8px 24px;
  }
  .brand-icon {
    height: 20px;
    width: auto;
    color: var(--adm-ink);
  }
  .wordmark {
    font-family: 'Barlow', sans-serif;
    font-size: var(--adm-text-md);
    font-weight: 700;
    letter-spacing: 0.4px;
    color: var(--adm-ink);
  }

  /* Toggle mobile — oculto por defecto, `.topbar` solo lo muestra bajo
     860px (regla de abajo). El checkbox queda visualmente oculto pero
     enfocable (no `display:none`) para no romper el foco por teclado. */
  .nav-toggle-input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border: 1px solid var(--adm-border);
    border-radius: var(--adm-radius-control);
    cursor: pointer;
  }
  .nav-toggle-input:focus-visible + .nav-toggle {
    outline: 2px solid var(--adm-accent);
    outline-offset: 2px;
  }
  .nav-backdrop {
    display: none;
  }
  .nav-toggle-icon,
  .nav-toggle-icon::before,
  .nav-toggle-icon::after {
    width: 16px;
    height: 2px;
    background: var(--adm-ink);
    border-radius: 1px;
  }
  .nav-toggle-icon {
    position: relative;
    transition: background-color 0.15s;
  }
  .nav-toggle-icon::before,
  .nav-toggle-icon::after {
    content: '';
    position: absolute;
    left: 0;
    transition: transform 0.15s;
  }
  .nav-toggle-icon::before {
    top: -5px;
  }
  .nav-toggle-icon::after {
    top: 5px;
  }
  /* Estado abierto: hamburguesa → X. */
  .sidebar:has(.nav-toggle-input:checked) .nav-toggle-icon {
    background: transparent;
  }
  .sidebar:has(.nav-toggle-input:checked) .nav-toggle-icon::before {
    top: 0;
    transform: rotate(45deg);
  }
  .sidebar:has(.nav-toggle-input:checked) .nav-toggle-icon::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .nav {
    flex: 1;
  }
  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .nav-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 10px 12px;
    border-radius: var(--adm-radius-control);
    font-family: 'Barlow', sans-serif;
    font-size: var(--adm-text-md);
    font-weight: 600;
    color: var(--adm-text);
    text-decoration: none;
    transition:
      background-color 0.15s,
      color 0.15s;
  }
  .nav-item:hover {
    background: var(--adm-bg);
  }
  .nav-item[data-active='true'] {
    background: var(--adm-accent-soft);
    color: var(--adm-accent);
  }
  /* Ítems sin pantalla propia: texto atenuado además del badge — nunca
     idénticos a un ítem activo (spec "Placeholder item is visually marked"). */
  .nav-item[data-soon='true'] {
    color: var(--adm-muted);
  }
  .nav-item[data-soon='true']:hover {
    color: var(--adm-text);
  }

  .badge {
    flex-shrink: 0;
    background: var(--adm-bg);
    color: var(--adm-muted);
    border-radius: var(--adm-radius-pill);
    padding: 3px 8px;
    font-size: var(--adm-text-xs);
    font-weight: 700;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }

  .footer {
    padding-top: 16px;
    border-top: 1px solid var(--adm-border);
  }

  @media (max-width: 860px) {
    .sidebar {
      width: 100%;
      min-height: auto;
      border-right: none;
      border-bottom: 1px solid var(--adm-border);
      padding: 12px 16px;
    }
    .brand {
      padding: 4px 8px;
    }
    .nav-toggle {
      display: flex;
    }
    /* Fondo oscuro detrás del drawer — clickeable (es el <label> del
       toggle) para cerrar sin JS. */
    .nav-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(20, 33, 58, 0.45);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
      z-index: 55;
    }
    .sidebar:has(.nav-toggle-input:checked) .nav-backdrop {
      opacity: 1;
      pointer-events: auto;
    }

    /* Panel lateral: se superpone al contenido en vez de empujarlo.
       `visibility` transiciona junto con `transform` para sacar el
       drawer del árbol de foco/tab cuando está cerrado, sin JS
       (comportamiento nativo de `visibility` en transiciones: entra
       visible al abrir, sale hidden al terminar de cerrar). */
    .collapsible {
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      width: min(280px, 80vw);
      display: flex;
      flex-direction: column;
      background: var(--adm-surface);
      padding: 20px 16px;
      overflow-y: auto;
      box-shadow: 4px 0 24px rgba(20, 33, 58, 0.16);
      transform: translateX(-100%);
      visibility: hidden;
      transition:
        transform 0.25s ease,
        visibility 0.25s ease;
      z-index: 60;
    }
    .sidebar:has(.nav-toggle-input:checked) .collapsible {
      transform: translateX(0);
      visibility: visible;
    }

    .nav-list {
      flex-direction: column;
    }
    .footer {
      display: block;
    }
  }
</style>

<script>
  // Re-sincroniza el estado que `AdminShell.astro` congela al persistir este
  // componente entre navegaciones SPA (ver el comentario del `<aside>` más
  // arriba): qué `.nav-item` está activo, y el checkbox del drawer mobile.
  function syncSidebar() {
    const path = window.location.pathname;
    for (const link of document.querySelectorAll<HTMLAnchorElement>('.nav-item')) {
      const href = link.getAttribute('href') ?? '';
      // Misma regla que el cálculo original en el frontmatter: `/admin` es
      // match exacto (si no, cualquier ruta `/admin/*` lo marcaría activo
      // también), el resto es prefijo.
      const isActive = href === '/admin' ? path === '/admin' : path.startsWith(href);
      link.dataset.active = String(isActive);
    }
    // El drawer es un checkbox pensado para full reload (cada link recargaba
    // la página entera, así que "cerrarse" era gratis). Con el nodo
    // persistido, el checkbox sobrevive a la navegación — sin este reset
    // quedaría abierto en mobile después de tocar un link.
    const toggle = document.getElementById('admin-nav-toggle');
    if (toggle instanceof HTMLInputElement) toggle.checked = false;
  }

  document.addEventListener('astro:page-load', syncSidebar);
</script>
