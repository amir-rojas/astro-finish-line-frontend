---
// AdminSidebar — navegación fija del panel admin (ver `sdd/admin-dashboard`,
// design D6 + spec "Admin sidebar navigation"). Renderiza `ADMIN_NAV`
// (fuente única, `nav.ts`) y marca el ítem activo por `Astro.url.pathname`.
// Los ítems `soon` son links reales con un badge atenuado — nunca
// `aria-disabled` ni un `#` muerto (spec "Placeholder item is visually
// marked").
//
// Toggle mobile: checkbox + `:has()`, sin JS de cliente (`AdminShell` es
// SSR puro, ver ese archivo). El estado del checkbox se resetea solo al
// navegar porque `AdminLayout` no lleva `<ClientRouter/>` — cada link es
// full reload, así que no hace falta cerrar el drawer "a mano".
import { ADMIN_NAV } from '@admin/components/nav';

const currentPath = Astro.url.pathname;
---

<aside class="sidebar">
  <div class="topbar">
    <div class="brand">
      <svg class="brand-icon" viewBox="50 3 852 391" fill="currentColor" aria-hidden="true" focusable="false">
        {/* Mismo isotipo inline que `pages/admin/login.astro` — un solo color a
            este tamaño. Ver ese archivo para el comentario completo sobre por
            qué no se extrajo a un componente todavía. */}
        <g transform="translate(0,632) scale(0.1,-0.1)">
