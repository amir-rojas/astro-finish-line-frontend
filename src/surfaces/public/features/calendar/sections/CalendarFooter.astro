---
// CalendarFooter — footer SLIM para las páginas del calendario (/calendario y
// /calendario/[slug]). A diferencia de SiteFooter (home/sections/), NO es
// event-driven: no hay un evento único del que sacar whatsapp/redes/organizador/
// fecha/ciudad. Se limita a marca + copyright + un link mínimo de vuelta a la
// home. Sin status/badges decorativos.
const year = new Date().getFullYear();
---

<footer class="cft">
  <div class="cft__inner">
    <a href="/" class="cft__brand" aria-label="Finish Line — inicio">
      <span class="cft__mark" aria-hidden="true"></span>
      <span class="cft__word">FINISH LINE</span>
    </a>

    <nav class="cft__nav" aria-label="Enlaces">
      <a href="/">Inicio</a>
    </nav>

    <span class="cft__legal">© {year} Finish Line Sporting Events</span>
  </div>
</footer>

<style>
  .cft {
    background: var(--fl-navy);
    color: var(--fl-cream);
    border-top: 1px solid rgba(246, 240, 228, 0.12);
  }
  .cft__inner {
    max-width: var(--fl-container);
    margin: 0 auto;
    padding: clamp(28px, 4vw, 40px) clamp(20px, 5vw, 56px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }

  .cft__brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    flex-shrink: 0;
  }
  .cft__mark {
    width: 11px;
    height: 11px;
    background: var(--fl-orange);
  }
  .cft__word {
    font-family: 'Archivo Black', sans-serif;
    font-size: 16px;
    letter-spacing: 1px;
    color: var(--fl-cream);
  }

  .cft__nav {
    display: flex;
    gap: 20px;
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  .cft__nav a {
    color: var(--fl-on-navy-soft);
    text-decoration: none;
    transition: color 160ms var(--ease-out);
  }
  .cft__nav a:hover {
    color: var(--fl-cream);
  }

  .cft__legal {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #5d6f86;
  }

  @media (prefers-reduced-motion: reduce) {
    .cft__nav a {
      transition: none;
    }
  }
</style>
