---
// RaceRewards — banda de vitrina del detalle: muestra el merch tangible del
// evento (polera oficial + medalla finisher) con foto real. Es un momento
// "mostrar, no afirmar": el atleta ve lo que se lleva antes de inscribirse.
//
// Banda sobre CREMA CÁLIDA (--fl-cream-2), enmarcada con hairlines: un escalón
// tonal suave entre el hero y el detalle (ambos crema), no un salto de color.
// Las fotos van en tarjetas blancas (--fl-surface), mismo lenguaje que las
// tarjetas de Modalidades — consistencia visual del detalle.
//
// Ambos ítems son OPCIONALES e INDEPENDIENTES. El componente recibe solo los
// que existen; si la lista llega vacía, NO renderiza nada (la página se ve
// completa sin la banda — mismo patrón que EventInfo sin bloques). Un solo
// ítem se centra, sin dejar un hueco.
//
// Tratamiento robusto para imágenes arbitrarias de Strapi: cada foto va en una
// PLACA clara con object-fit: contain — nunca recorta (da igual proporción u
// origen: render sobre blanco, foto oscura, PNG transparente) y unifica piezas
// dispares sobre el navy.
import { Image } from 'astro:assets';

/** Una foto local importada (ImageMetadata) o una URL remota de Strapi. */
export type RewardSource = ImageMetadata | string;

export interface RewardItem {
  src: RewardSource;
  alt: string;
  /** Label grande de marca, p.ej. "Polera oficial". */
  label: string;
}

interface Props {
  items: RewardItem[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="rewards" aria-labelledby="rewards-title">
      <div class="rewards__inner">
        <h2 id="rewards-title" class="rewards__title" data-reveal>
          Lo que te llevás
        </h2>

        <div class="rewards__grid">
          {items.map((item, i) => (
            <figure class="reward" data-reveal data-delay={i + 1}>
              <div class="reward__tile">
                <Image
                  class="reward__img"
                  src={item.src}
                  alt={item.alt}
                  inferSize={typeof item.src === 'string' ? true : undefined}
                  widths={[320, 480, 640]}
                  sizes="(max-width: 640px) 88vw, 380px"
                  loading="lazy"
                />
              </div>
              <figcaption class="reward__label">{item.label}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  /* Full-bleed: la sección vive FUERA del contenedor del detalle, así que su
     fondo sangra a todo el ancho y su contenido se recentra adentro. Crema
     cálida + hairlines = banda distinta sin cortar el tono claro de la página. */
  .rewards {
    background: var(--fl-cream-2);
    border-top: 1px solid var(--fl-hairline-ink);
    border-bottom: 1px solid var(--fl-hairline-ink);
  }
  .rewards__inner {
    max-width: var(--fl-container);
    margin: 0 auto;
    padding: clamp(56px, 8vw, 104px) clamp(20px, 5vw, 56px);
  }

  .rewards__title {
    margin: 0 0 clamp(32px, 5vw, 56px);
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(32px, 4.4vw, 56px);
    line-height: 0.98;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-wrap: balance;
    text-align: center;
    color: var(--fl-ink);
  }

  /* Flex-wrap centrado (no grid rígido): con un solo ítem queda centrado sin
     dejar una columna vacía; con dos, lado a lado. */
  .rewards__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(28px, 5vw, 56px);
  }

  .reward {
    margin: 0;
    flex: 0 1 380px;
    max-width: 420px;
    display: flex;
    flex-direction: column;
  }

  /* Placa clara: unifica render sobre blanco y foto oscura, y hace de marco.
     Esquinas rectas, fiel al lenguaje del surface. */
  .reward__tile {
    aspect-ratio: 4 / 5;
    background: var(--fl-surface);
    overflow: hidden;
  }
  .reward__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* Aire dentro del marco para que la pieza no toque los bordes. */
    padding: clamp(18px, 3vw, 34px);
  }

  /* Label protagonista: Archivo Black grande, no un mini-label del montón. */
  .reward__label {
    margin: clamp(16px, 2.2vw, 24px) 0 0;
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(22px, 3.2vw, 34px);
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-align: center;
    color: var(--fl-ink);
  }
</style>
