---
// RaceRow — una fila del listado /calendario: bloque de fecha, nombre +
// chips de distancia + badge de estado agregado, y CTA de texto hacia el
// detalle interno (nunca hacia Eventrid — eso vive solo en el detalle).
import type { CalendarEvent } from '@shared/lib/server/strapi-client';
import { dayMonth, raceStatus } from '../format';

interface Props {
  event: CalendarEvent;
}
const { event } = Astro.props;

const { day, month } = dayMonth(event.date);
// `distances` viene de modalidades.map(distancia) y puede traer duplicados
// (varias modalidades a la misma distancia con distinto label/precio).
const distances = [...new Set(event.distances)];
const status = raceStatus(event.modalities);
---

<li class="rr">
  <div class="rr__date">
    <span class="rr__day">{day}</span>
    <span class="rr__month">{month}</span>
  </div>

  <div class="rr__body">
    <h2 class="rr__name">{event.title}</h2>
    <div class="rr__meta">
      {distances.map((d) => <span class="rr__chip">{d}</span>)}
      {status && <span class={`rr__status rr__status--${status.tone}`}>{status.label}</span>}
    </div>
  </div>

  <a class="rr__cta" href={`/calendario/${event.slug}`}>
    Ver carrera <span class="rr__arrow" aria-hidden="true">→</span>
  </a>
</li>

<style>
  .rr {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(20px, 4vw, 40px);
    padding: clamp(22px, 3vw, 32px) 0;
    border-bottom: 1px solid rgba(14, 28, 48, 0.12);
  }

  .rr__date {
    display: flex;
    flex-direction: column;
    line-height: 0.9;
    color: var(--fl-navy);
  }
  .rr__day {
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(28px, 3.2vw, 36px);
  }
  .rr__month {
    margin-top: 4px;
    font-family: 'Space Mono', monospace;
    font-size: 13px;
    letter-spacing: 1.5px;
  }

  .rr__body {
    min-width: 0;
  }
  .rr__name {
    margin: 0;
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(19px, 2.4vw, 24px);
    line-height: 1.15;
    text-transform: uppercase;
    color: var(--fl-navy);
  }
  .rr__meta {
    margin-top: 10px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .rr__chip {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    background: var(--fl-navy);
    color: var(--fl-cream);
    padding: 5px 9px;
  }
  .rr__status {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 5px 9px;
    color: #fff;
  }
  /* Tonos con contraste AA (>=4.5:1) para el texto blanco sobre el chip. El
     label textual siempre acompaña al color — nunca es color-only. */
  .rr__status--open {
    background: #1f7a4d;
  }
  .rr__status--warning {
    background: #a15c00;
  }
  .rr__status--closed {
    background: #52525b;
  }

  .rr__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Space Mono', monospace;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--fl-orange-strong);
    text-decoration: none;
    white-space: nowrap;
    transition: gap 160ms var(--ease-out);
  }
  .rr__arrow {
    transition: transform 160ms var(--ease-out);
  }
  @media (hover: hover) {
    .rr__cta:hover .rr__arrow {
      transform: translateX(4px);
    }
  }

  @media (max-width: 640px) {
    .rr {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        'date body'
        'cta  cta';
      row-gap: 14px;
    }
    .rr__date {
      grid-area: date;
    }
    .rr__body {
      grid-area: body;
    }
    .rr__cta {
      grid-area: cta;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rr__cta,
    .rr__arrow {
      transition: none;
    }
  }
</style>
