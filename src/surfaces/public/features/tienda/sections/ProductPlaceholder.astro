---
// ProductPlaceholder — foto real cuando `producto.image` está cargada en
// Sanity; si no, motivo de color neutro. Costura única: ningún card decide
// esto por su cuenta, todos delegan acá.
//
// Tres variantes de bloque (`block-a/b/c`) para que la grilla no se vea como
// cinco copias del mismo rectángulo — un desacuerdo tonal sutil, no un patrón
// decorativo nuevo: los tres se derivan de los tokens navy/orange existentes.
import { Image } from 'astro:assets';

interface Props {
  placeholder: 'block-a' | 'block-b' | 'block-c';
  imageAlt: string;
  image?: ImageMetadata;
}
const { placeholder, imageAlt, image } = Astro.props;
---

{
  image ? (
    <Image
      class="pp pp--photo"
      src={image}
      alt={imageAlt}
      widths={[400, 800]}
      sizes="(min-width: 1024px) 400px, 50vw"
      loading="lazy"
    />
  ) : (
    <div class={`pp pp--${placeholder}`} role="img" aria-label={imageAlt} />
  )
}

<style>
  .pp {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }
  /* `position: absolute; inset: 0` en vez de heredar el `width/height: 100%`
     relativo de `.pp`: mismo patrón que `.rc__img`/`.reward__img` para una foto
     dentro de un frame `aspect-ratio` — evita cualquier ambigüedad de alto
     porcentual y es lo que de verdad hace que `object-fit: cover` recorte en
     vez de deformar. */
  .pp--photo {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pp::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      135deg,
      rgba(246, 240, 228, 0.06) 0px,
      rgba(246, 240, 228, 0.06) 2px,
      transparent 2px,
      transparent 14px
    );
  }
  .pp--block-a {
    background: var(--fl-navy);
  }
  .pp--block-b {
    background: var(--fl-navy-2);
  }
  .pp--block-c {
    background: var(--fl-navy-3);
  }
</style>
