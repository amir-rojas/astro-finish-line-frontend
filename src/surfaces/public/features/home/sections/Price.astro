---
// Sección combinada de INSCRIPCIÓN: se presenta como un DORSAL de carrera
// (ficha acotada con encabezado de evento y banda de meta a cuadros) que hoy
// ofrece VARIAS vías de inscripción — p.ej. una GRATIS (cupo cubierto) y otra
// de pago con kit. Debajo, las categorías como info práctica del mismo clúster.
// Lleva id="categorias" para el ancla del nav (Hero y Footer embudonan acá).
import type { EventData } from '../format';

interface Props {
  event: EventData;
}
const { event } = Astro.props;
const distance = event.distances[0] ?? '';
const year = event.date.getUTCFullYear();

// Vías de inscripción. Deriva de `registrationOptions` (modelo nuevo: la carrera
// puede tener gratis + pago). Fallback al modelo legacy (price único) para no
// romper eventos sin migrar. "Gratis" sale del dato real (amount === 0).
type Option = {
  label: string;
  amount: number;
  currency: string;
  url?: string;
  includes: string[];
  note?: string;
  featured: boolean;
};

const options: Option[] =
  event.registrationOptions.length > 0
    ? event.registrationOptions.map((o) => ({
        label: o.label,
        amount: o.price.amount,
        currency: o.price.currency,
        url: o.url,
        includes: o.includes,
        note: o.note,
        featured: o.featured,
      }))
    : event.price
      ? [
          {
            label: 'Inscripción',
            amount: event.price.amount,
            currency: event.price.currency,
            url: event.registrationUrl,
            includes: event.includes,
            note: event.registrationNote,
            featured: true,
          },
        ]
      : [];

const single = options.length === 1;

// Ítems que aparecen en TODAS las vías (compartidos) vs. exclusivos de una.
// El diferenciador real (p.ej. el kit) sale del dato: es lo que una vía incluye
// y la otra no. Se marca visualmente para que la razón de elegir una u otra se
// lea sin comparar listas ítem por ítem.
const sharedIncludes =
  options.length > 1
    ? options.reduce<string[]>(
        (acc, o) => acc.filter((c) => o.includes.includes(c)),
        [...options[0].includes],
      )
    : [];
---

<section id="categorias" class="enroll">
  <div class="enroll__inner">
    {
      options.length > 0 && (
        <div class="bib" data-reveal>
          <header class="bib__head">
            <h2 class="bib__tag">Inscripción</h2>
            <span class="bib__event">
              {event.title} · {year}
            </span>
          </header>

          <div class="bib__flag" aria-hidden="true" />

          <div class:list={['opts', single && 'opts--single']}>
            {options.map((o, i) => {
              const isFree = o.amount === 0;
              return (
                <article
                  class:list={['opt', o.featured && 'opt--featured']}
                  data-reveal
                  data-delay={String(i + 1)}
                >
                  <div class="opt__body">
                    <p class="opt__eyebrow">{o.label}</p>

                    {isFree ? (
                      <p class="opt__amount opt__amount--free">Gratis</p>
                    ) : (
                      <p class="opt__amount">
                        <span class="opt__num">{o.amount}</span>
                        <span class="opt__cur">{o.currency}</span>
                      </p>
                    )}

                    {o.includes.length > 0 && (
                      <ul class="opt__incl">
                        {o.includes.map((c) => {
                          const isKey = options.length > 1 && !sharedIncludes.includes(c);
                          return (
                            <li class:list={['opt__incl-item', isKey && 'opt__incl-item--key']}>
                              {isKey && (
                                <svg class="opt__incl-ico" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                  <path d="M2.7 5.4h10.6l-1 9.1H3.7z" fill="currentColor" />
                                  <path d="M5.4 5.4V4.7a2.6 2.6 0 0 1 5.2 0v.7" stroke="currentColor" stroke-width="1.5" />
                                </svg>
                              )}
                              {c}
                            </li>
                          );
                        })}
                      </ul>
                    )}

                    {o.note && <p class="opt__note">{o.note}</p>}
                  </div>

                  {o.url && (
                    <a
                      class="opt__cta"
                      href={o.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {isFree ? 'Inscribirse gratis' : `Inscribirse — ${o.amount} ${o.currency}`}
                      <span class="opt__arrow" aria-hidden="true">→</span>
                    </a>
                  )}
                </article>
              );
            })}
          </div>
        </div>
      )
    }

    {
      event.categories.length > 0 && (
        <div class="enroll__cats">
          <div class="cats__head" data-reveal>
            <h2 class="cats__title">
              Categorías {distance && <span class="cats__hl">{distance}</span>}
            </h2>
            <p class="cats__kicker">Damas y Varones</p>
          </div>

          <div class="cats__grid">
            {event.categories.map((cat, i) => (
              <article class="cat" data-reveal data-delay={String(i + 1)}>
                <div class="cat__body">
                  <h3 class="cat__name">{cat.name}</h3>
                  <p class="cat__ages">{cat.ages}</p>
                </div>
              </article>
            ))}
          </div>

          {event.categoriesNote && <p class="cats__note" data-reveal>{event.categoriesNote}</p>}
        </div>
      )
    }
  </div>
</section>

<style>
  .enroll {
    position: relative;
    overflow: hidden;
    background: var(--fl-navy);
    color: var(--fl-cream);
  }
  .enroll__inner {
    position: relative;
    width: 100%;
    max-width: var(--fl-container);
    margin: 0 auto;
    padding: clamp(56px, 8vw, 104px) clamp(20px, 5vw, 56px);
  }

  /* --- DORSAL (ficha de inscripción) ------------------------------------- */
  .bib {
    position: relative;
    max-width: 760px;
    margin: 0 auto;
    /* Superficie un punto más clara que el lienzo: profundidad por tono, no
       por sombra (coherente con la filosofía de marca). */
    background: color-mix(in oklab, var(--fl-navy), white 5%);
    border: 1px solid var(--fl-edge);
  }

  .bib__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding: clamp(16px, 2.4vw, 22px) clamp(20px, 3vw, 34px);
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .bib__tag {
    margin: 0;
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--fl-orange);
  }
  .bib__event {
    color: var(--fl-on-navy-muted);
  }

  /* Bandera de meta a cuadros: el motivo de marca, como banda fina. */
  .bib__flag {
    height: 12px;
    background-color: var(--fl-orange);
    background-image:
      linear-gradient(45deg, var(--fl-navy) 25%, transparent 25% 75%, var(--fl-navy) 75%),
      linear-gradient(45deg, var(--fl-navy) 25%, transparent 25% 75%, var(--fl-navy) 75%);
    background-size: 12px 12px;
    background-position: 0 0, 6px 6px;
  }

  /* --- Vías de inscripción (tarjetas dentro del dorsal) ------------------ */
  /* Dos columnas en escritorio; el separador fino entre ellas lee a
     comprobante, coherente con el motivo del dorsal. */
  .opts {
    display: grid;
    /* 60/40: la vía de pago (con kit, primera) manda; la gratis acompaña. */
    grid-template-columns: 3fr 2fr;
  }
  .opts--single {
    grid-template-columns: 1fr;
  }
  .opt {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(28px, 3.6vw, 44px) clamp(22px, 3vw, 34px) clamp(24px, 3vw, 32px);
  }
  .opt + .opt {
    border-left: 1px solid var(--fl-hairline);
  }
  /* El cuerpo crece para que ambas tarjetas alineen su CTA al fondo. */
  .opt__body {
    flex: 1;
  }

  .opt__eyebrow {
    margin: 0 0 14px;
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--fl-orange);
  }

  /* Monto: el número ES el dorsal. */
  .opt__amount {
    margin: 0;
    font-family: 'Archivo Black', sans-serif;
    line-height: 0.84;
    letter-spacing: -0.04em;
    white-space: nowrap;
    color: var(--fl-cream);
  }
  .opt__num {
    font-size: clamp(50px, 7.5vw, 80px);
  }
  .opt__cur {
    color: var(--fl-orange);
    font-size: clamp(22px, 3vw, 34px);
    letter-spacing: -0.02em;
    margin-left: 8px;
  }
  /* "Gratis" ocupa el lugar del monto: la palabra ES el dorsal. */
  /* "Gratis" es la vía secundaria y vive en la columna angosta (40%): más chico
     que el número de pago, sin desbordar su contenedor. */
  .opt__amount--free {
    font-size: clamp(34px, 4.6vw, 54px);
    text-transform: uppercase;
    color: var(--fl-orange);
  }

  .opt__incl {
    list-style: none;
    margin: clamp(20px, 2.6vw, 28px) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .opt__incl-item {
    position: relative;
    padding-left: 22px;
    font-size: clamp(14px, 1.5vw, 16px);
    line-height: 1.35;
    color: var(--fl-cream);
  }
  /* Marca naranja (motivo de marca) como viñeta. */
  .opt__incl-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.42em;
    width: 9px;
    height: 9px;
    background: var(--fl-orange);
  }
  /* Ítem exclusivo de una vía (el diferenciador, p.ej. el kit): reemplaza la
     viñeta por un ícono de kit y engrosa el texto, para que se lea de un vistazo
     qué obtiene de más quien elige esta vía. */
  /* El diferenciador (el kit) es el titular visual de la tarjeta de pago: la
     única razón para elegir esta vía sobre la gratis. Sube de tamaño respecto
     al resto de la lista y separa con aire para que se lea de un vistazo. */
  .opt__incl-item--key {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-left: 0;
    margin-bottom: 6px;
    font-size: clamp(17px, 2vw, 20px);
    font-weight: 700;
    letter-spacing: 0.005em;
    color: var(--fl-cream);
  }
  .opt__incl-item--key::before {
    display: none;
  }
  /* Ícono del kit: comparte el riel de las demás viñetas (borde izquierdo en 0)
     y el texto arranca a 22px como el resto (16px ícono + 6px gap). El centrado
     vertical lo resuelve flex sobre su propia línea — sin position:absolute ni
     nudges de `top` que lo desalineaban. */
  .opt__incl-ico {
    flex: none;
    width: 16px;
    height: 16px;
    color: var(--fl-orange);
  }

  .opt__note {
    margin: 14px 0 0;
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.5px;
    color: var(--fl-on-navy-muted);
  }

  /* CTA por vía: ambas vías son acciones equivalentes (gratis y con kit),
     así que las dos van sólidas — ninguna se presenta como secundaria. */
  .opt__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    box-sizing: border-box;
    margin-top: clamp(24px, 3vw, 34px);
    padding: 16px 24px;
    background: var(--fl-orange-strong);
    color: #fff;
    font-family: 'Space Mono', monospace;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-align: center;
    text-decoration: none;
    transition:
      transform 180ms var(--ease-out),
      background-color 180ms var(--ease-out);
  }
  .opt__arrow {
    transition: transform 180ms var(--ease-out);
  }
  @media (hover: hover) {
    .opt__cta:hover {
      background: var(--fl-orange-hover);
      transform: translateY(-2px);
    }
    .opt__cta:hover .opt__arrow {
      transform: translateX(4px);
    }
  }
  .opt__cta:active {
    transform: scale(0.97);
  }
  /* Foco de teclado visible (WCAG 2.4.7): contorno sólido, sin blur, coherente
     con la regla no-glow. Crema contrasta contra el naranja y contra el navy. */
  .opt__cta:focus-visible {
    outline: 2px solid var(--fl-cream);
    outline-offset: 3px;
  }
  /* Vía secundaria (gratis): CTA fantasma. La vía con kit es la acción sólida y
     dominante; la gratis sigue clara y clickeable, pero se lee secundaria. */
  .opt:not(.opt--featured) .opt__cta {
    background: transparent;
    color: var(--fl-cream);
    border: 1.5px solid var(--fl-orange-strong);
  }
  @media (hover: hover) {
    .opt:not(.opt--featured) .opt__cta:hover {
      background: var(--fl-orange-hover);
      color: #fff;
    }
  }

  /* Móvil: las vías se apilan. El separador pasa a una banda a cuadros de meta
     (el motivo de marca) que lee a "perforación entre comprobantes": deja el
     límite entre vías inequívoco incluso en un scroll rápido, donde una línea
     de 1px al 12% se perdía. */
  @media (max-width: 560px) {
    .opts {
      grid-template-columns: 1fr;
    }
    .opt + .opt {
      border-left: none;
      padding-top: clamp(34px, 9vw, 44px);
    }
    .opt + .opt::before {
      content: '';
      position: absolute;
      top: 0;
      left: clamp(22px, 3vw, 34px);
      right: clamp(22px, 3vw, 34px);
      height: 6px;
      background-color: var(--fl-orange);
      background-image:
        linear-gradient(45deg, var(--fl-navy) 25%, transparent 25% 75%, var(--fl-navy) 75%),
        linear-gradient(45deg, var(--fl-navy) 25%, transparent 25% 75%, var(--fl-navy) 75%);
      background-size: 6px 6px;
      background-position: 0 0, 3px 3px;
    }
  }

  /* --- Categorías (sub-bloque del mismo clúster) ------------------------- */
  .enroll__cats {
    margin-top: clamp(48px, 7vw, 88px);
  }
  .cats__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .cats__title {
    margin: 0;
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(30px, 4vw, 50px);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: var(--fl-cream);
  }
  .cats__hl {
    color: var(--fl-orange);
  }
  .cats__kicker {
    margin: 0;
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--fl-on-navy-muted);
  }
  .cats__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1px;
    background: var(--fl-hairline);
    border-block: 1px solid var(--fl-hairline);
  }
  .cat {
    background: var(--fl-navy);
    padding: 28px clamp(20px, 2.2vw, 28px) 30px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: background-color 220ms var(--ease-out);
  }
  .cat__name {
    margin: 0;
    font-family: 'Archivo Black', sans-serif;
    font-size: 26px;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--fl-cream);
  }
  .cat__ages {
    margin: 6px 0 0;
    font-size: 16px;
    color: var(--fl-on-navy-soft);
  }
  @media (hover: hover) {
    .cat:hover {
      background: var(--fl-wash);
    }
  }
  .cats__note {
    margin: 18px 0 0;
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.5px;
    color: var(--fl-on-navy-muted);
  }
</style>
