---
// RunTour — MÓDULO 2 de la home: banda de la serie "Run Tour Finish Line".
//
// Concepto ("la medalla que se arma"): la recompensa del tour son 3 MEDALLONES
// circulares que se enganchan en HORIZONTAL (una medalla por etapa; al completar
// las tres, se unen en el símbolo del tour). Ref. física: design-reference/
// medalle-reference.png y medalla-1.png. Vuelve visible el objetivo de negocio
// (correr las 3 fechas). *Mostrar, no afirmar.* La MEDALLA es la protagonista:
// el número manda dentro de cada moneda, la escena de montaña es sólo un acento.
//
// Registro FILOSO fiel a DESIGN.md (elección de Amir): sin glow/glass/metal falso.
// Emblema vectorial de marca (navy/crema/naranja + aro a cuadros de meta). Es
// placeholder + fallback permanente; cuando llegue la foto real (metálica) entra
// en esta misma cadena de 3 sin re-diseñar el resto.
//
// Estado (decisión Amir 2026-07-06): sólo la ETAPA 1 desbloqueada; 2 y 3 por
// desbloquear (moneda en contorno + candado). Etapas hardcodeadas: Strapi aún no
// modela la serie.

const stages = [
  { n: 1, when: '16 AGO 2026', locked: false },
  { n: 2, when: '25 OCT 2026', locked: true },
  { n: 3, when: 'Por definir', locked: true },
];
---

<section class="tour">
  {/* Defs compartidos por los 3 medallones: aro a cuadros de meta + arco del texto. */}
  <svg class="rt-defs" width="0" height="0" aria-hidden="true">
    <defs>
      <pattern id="rt-checker" width="12" height="12" patternUnits="userSpaceOnUse">
        <rect class="ck-o" width="12" height="12"></rect>
        <rect class="ck-n" width="6" height="6"></rect>
        <rect class="ck-n" x="6" y="6" width="6" height="6"></rect>
      </pattern>
      <path id="rt-arc" d="M42,100 A58,58 0 0 1 158,100"></path>
    </defs>
  </svg>

  <div class="tour__inner">
    <header class="tour__head">
      <div>
        <p class="tour__kicker" data-reveal>La serie</p>
        <h2 class="tour__title" data-reveal data-delay="1">Run Tour Finish Line</h2>
      </div>
      <span class="tour__badge" data-reveal data-delay="1">1ª edición · 3 etapas</span>
    </header>

    {/* Cadena horizontal de medallones — el objeto-héroe. Grid de 5 columnas:
        monedas en 1/3/5 y eslabones en 2/4 (fila 1); captions bajo cada moneda
        (fila 2, mismas columnas) para que queden alineadas. */}
    <div class="chain">
      {
        stages.map((s, i) => (
          <Fragment>
            {i > 0 && <span class="link" style={`grid-column:${i * 2};grid-row:1`} aria-hidden="true" />}
            <div class:list={['coin', { 'coin--locked': s.locked }]} style={`grid-column:${i * 2 + 1};grid-row:1`}>
              <svg class="coin__svg" viewBox="0 0 200 200" aria-hidden="true">
                <circle class="coin__rim" cx="100" cy="100" r="84" />
                <circle class="coin__field" cx="100" cy="100" r="77" />
                <text class="coin__arc">
                  <textPath href="#rt-arc" startOffset="50%">RUN TOUR</textPath>
                </text>
                {/* Acento La Paz: cresta de cordillera (secundaria, no compite con el nº). */}
                <path class="coin__crest" d="M72,80 L86,62 L98,72 L112,58 L128,80 Z" />
                <text class="coin__num" x="100" y="126">{s.n}</text>
              </svg>
            </div>
          </Fragment>
        ))
      }
      {
        stages.map((s, i) => (
          <p class:list={['cap', { 'cap--locked': s.locked }]} style={`grid-column:${i * 2 + 1};grid-row:2`}>
            <span class="cap__stage">{`Etapa ${s.n}`}</span>
            <span class="cap__when">{s.when}</span>
            <span class="cap__state">
              {s.locked ? (
                <>
                  <svg class="cap__ico" viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="4.5" y="10.5" width="15" height="10" rx="0" />
                    <path class="cap__ico-sh" d="M8,10.5 V7.5 a4,4 0 0 1 8,0 V10.5" />
                  </svg>
                  Por desbloquear
                </>
              ) : (
                <>
                  <span class="cap__dot" aria-hidden="true" />
                  Desbloqueada
                </>
              )}
            </span>
          </p>
        ))
      }
    </div>

    <p class="tour__lead" data-reveal data-delay="2">
      Completá las tres etapas para ensamblar una medalla única. Cada carrera desbloquea una pieza
      y, al cruzar la meta final, las tres se unen para formar el símbolo del
      <b> Run Tour Finish Line</b>.
    </p>
  </div>
</section>

<script>
  // Ensamblado al entrar en viewport: mejora progresiva sobre el estado por
  // defecto (cadena YA armada). Sin JS o con reduced-motion se ve completa; el
  // movimiento nunca bloquea contenido.
  const chain = document.querySelector<HTMLElement>('.chain');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (chain && !reduce && 'IntersectionObserver' in window) {
    chain.classList.add('motion-armed');
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.35 },
    );
    io.observe(chain);
  }
</script>

<style>
  .tour {
    position: relative;
    overflow: hidden;
    /* Escenario limpio (se quitaron las rayas del mockup). Viñeteado radial
       sutilísimo para asentar el objeto — luz de escenario, no glow. */
    background: radial-gradient(120% 82% at 50% 40%, var(--fl-navy-2), var(--fl-navy) 80%);
    color: var(--fl-cream);
  }
  .rt-defs {
    position: absolute;
  }
  .tour__inner {
    position: relative;
    z-index: 1;
    max-width: var(--fl-container);
    margin: 0 auto;
    padding: clamp(60px, 9vw, 116px) clamp(20px, 5vw, 56px);
  }

  .tour__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
  }
  .tour__kicker {
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--fl-orange);
  }
  .tour__title {
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(26px, 4.4vw, 48px);
    line-height: 0.96;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin: 12px 0 0;
  }
  .tour__badge {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--fl-cream);
    border: 1px solid rgba(246, 240, 228, 0.25);
    padding: 8px 14px;
    align-self: center;
  }

  /* ---- Cadena horizontal de medallones (protagonista) ---- */
  .chain {
    display: grid;
    grid-auto-columns: max-content;
    justify-content: center;
    align-items: center;
    column-gap: clamp(2px, 1vw, 10px);
    row-gap: clamp(16px, 2.4vw, 26px);
    margin-top: clamp(40px, 6vw, 72px);
  }
  .coin {
    width: clamp(96px, 21vw, 212px);
  }
  .coin__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 16px 26px rgba(0, 0, 0, 0.32));
  }

  .coin__rim {
    fill: none;
    stroke: url(#rt-checker);
    stroke-width: 12;
  }
  .coin__field {
    fill: var(--fl-cream);
  }
  .coin__arc {
    font-family: 'Space Mono', monospace;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 3px;
    fill: var(--fl-navy);
    text-anchor: middle;
  }
  .coin__crest {
    fill: var(--fl-navy);
    opacity: 0.5;
  }
  .coin__num {
    font-family: 'Archivo Black', sans-serif;
    font-size: 62px;
    text-anchor: middle;
    dominant-baseline: central;
    fill: var(--fl-navy);
  }

  /* Medallón bloqueado: moneda vacía en contorno, contenido apagado. */
  .coin--locked {
    opacity: 0.68;
  }
  .coin--locked .coin__svg {
    filter: none;
  }
  .coin--locked .coin__field {
    fill: none;
    stroke: rgba(246, 240, 228, 0.3);
    stroke-width: 2;
    stroke-dasharray: 7 7;
  }
  .coin--locked .coin__rim {
    opacity: 0.4;
  }
  .coin--locked .coin__arc,
  .coin--locked .coin__num {
    fill: var(--fl-on-navy-soft);
  }
  .coin--locked .coin__crest {
    fill: none;
    stroke: var(--fl-on-navy-soft);
    stroke-width: 2;
    opacity: 0.5;
  }

  .ck-o {
    fill: var(--fl-orange);
  }
  .ck-n {
    fill: var(--fl-navy);
  }

  /* Eslabón tipo bisagra (subordinado: la medalla es la protagonista). */
  .link {
    width: clamp(16px, 3vw, 30px);
    height: 12px;
    background: var(--fl-on-navy-muted);
    align-self: center;
  }

  /* ---- Caption bajo cada medallón ---- */
  .cap {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    text-align: center;
    max-width: clamp(96px, 21vw, 212px);
  }
  .cap__stage {
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-size: clamp(14px, 1.8vw, 17px);
    color: var(--fl-cream);
    text-transform: uppercase;
  }
  .cap__when {
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--fl-on-navy-soft);
  }
  .cap__state {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 2px;
    font-family: 'Space Mono', monospace;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--fl-orange);
  }
  .cap--locked .cap__state {
    color: var(--fl-on-navy-soft);
  }
  .cap__dot {
    width: 8px;
    height: 8px;
    background: var(--fl-orange);
  }
  .cap__ico {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: var(--fl-on-navy-soft);
    stroke-width: 1.8;
  }
  .cap__ico rect {
    fill: var(--fl-on-navy-soft);
    stroke: none;
  }
  .cap__ico-sh {
    fill: none;
  }

  /* ---- Relato ---- */
  .tour__lead {
    margin: clamp(40px, 6vw, 68px) auto 0;
    max-width: 54ch;
    text-align: center;
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.55;
    color: var(--fl-on-navy-soft);
    text-wrap: pretty;
  }
  .tour__lead b {
    color: var(--fl-cream);
  }

  /* ================= MOTION: ensamblado al entrar ================= */
  /* Estado inicial sólo con JS (`.motion-armed`); sin JS = cadena ya armada. */
  .chain.motion-armed .coin {
    opacity: 0;
    transform: scale(0.88);
  }
  .chain.motion-armed .link {
    opacity: 0;
    transform: scaleX(0);
  }
  .chain.motion-armed.is-in .coin {
    opacity: 1;
    transform: none;
    transition:
      transform 0.55s var(--ease-out),
      opacity 0.5s var(--ease-out);
  }
  .chain.motion-armed.is-in .coin--locked {
    opacity: 0.68;
  }
  .chain.motion-armed.is-in .link {
    opacity: 1;
    transform: none;
    transition:
      transform 0.3s var(--ease-out),
      opacity 0.3s var(--ease-out);
  }
  /* Encaje de izquierda a derecha (nth-of-type cuenta por tag: .coin=div, .link=span). */
  .chain.motion-armed.is-in .coin:nth-of-type(1) {
    transition-delay: 0s;
  }
  .chain.motion-armed.is-in .link:nth-of-type(1) {
    transition-delay: 0.22s;
  }
  .chain.motion-armed.is-in .coin:nth-of-type(2) {
    transition-delay: 0.3s;
  }
  .chain.motion-armed.is-in .link:nth-of-type(2) {
    transition-delay: 0.5s;
  }
  .chain.motion-armed.is-in .coin:nth-of-type(3) {
    transition-delay: 0.58s;
  }

  .coin--locked {
    opacity: 0.68;
  }

  @media (max-width: 640px) {
    .cap__stage {
      font-size: 13px;
    }
    .cap__when {
      font-size: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chain.motion-armed .coin,
    .chain.motion-armed .link {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .chain.motion-armed .coin--locked {
      opacity: 0.68;
    }
  }
</style>
