---
// RunTour — MÓDULO 2 de la home: banda de la serie "Run Tour Finish Line".
//
// Concepto ("la medalla que se arma"): la recompensa del tour son 3 MEDALLONES
// circulares que se enganchan en VERTICAL (una medalla por etapa; al correr las
// tres, encajan en una cadena). Ref. física: design-reference/medalle-reference.png
// y medalla-1.png. Convierte el objetivo de negocio (correr las 3 fechas) en una
// recompensa visible. *Mostrar, no afirmar.*
//
// Registro FILOSO fiel a DESIGN.md (elección de Amir): sin glow/glass/metal falso.
// Los medallones son un EMBLEMA vectorial de marca (navy/crema/naranja + aro a
// cuadros de meta + montaña/ruta de La Paz en line-art). Es placeholder + fallback
// permanente; cuando llegue la foto real (metálica), entra en esta misma estructura
// de cadena de 3 sin re-diseñar el resto.
//
// Etapas HARDCODEADAS (decisión Amir 2026-07-06): Strapi aún no modela la serie.
// Estado honesto con el dato: 1 y 2 tienen fecha (medallón sólido); 3 "por definir"
// (medallón en contorno + eslabón abierto = aún por desbloquear).

const stages = [
  { n: 1, name: 'Run Tour Finish Line · Etapa 1', when: '16 AGO 2026', tbd: false },
  { n: 2, name: 'Run Tour Finish Line · Etapa 2', when: '25 OCT 2026', tbd: false },
  { n: 3, name: 'Run Tour Finish Line · Gran Final', when: 'Por definir', tbd: true },
];
---

<section class="tour">
  {/* Defs compartidos por los 3 medallones: aro a cuadros de meta + arco del texto. */}
  <svg class="rt-defs" width="0" height="0" aria-hidden="true">
    <defs>
      <pattern id="rt-checker" width="12" height="12" patternUnits="userSpaceOnUse">
        <rect class="ck-o" width="12" height="12"></rect>
        <rect class="ck-n" width="6" height="6"></rect>
        <rect class="ck-n" x="6" y="6" width="6" height="6"></rect>
      </pattern>
      <path id="rt-arc" d="M42,100 A58,58 0 0 1 158,100"></path>
    </defs>
  </svg>

  <div class="tour__inner">
    <header class="tour__head">
      <div>
        <p class="tour__kicker" data-reveal>La serie</p>
        <h2 class="tour__title" data-reveal data-delay="1">Run Tour Finish Line</h2>
      </div>
      <span class="tour__badge" data-reveal data-delay="1">1ª edición · 3 etapas</span>
    </header>

    <div class="tour__body">
      {/* Cadena vertical de medallones — el objeto-héroe. */}
      <div
        class="chain"
        role="img"
        aria-label="Medalla del Run Tour: tres medallones circulares que se enganchan al correr las tres etapas. Etapa 1 y 2 confirmadas; etapa 3 por definir."
      >
        {
          stages.map((s, i) => (
            <>
              {i > 0 && (
                <span class:list={['link', { 'link--open': stages[i].tbd }]} aria-hidden="true" />
              )}
              <div class:list={['coin', { 'coin--tbd': s.tbd }]}>
                <svg class="coin__svg" viewBox="0 0 200 200" aria-hidden="true">
                  <circle class="coin__rim" cx="100" cy="100" r="84" />
                  <circle class="coin__field" cx="100" cy="100" r="77" />

                  <text class="coin__arc">
                    <textPath href="#rt-arc" startOffset="50%">RUN TOUR</textPath>
                  </text>

                  {/* Escena La Paz: cordillera + ruta (line-art filoso). */}
                  <g class="coin__scene">
                    <path class="mtn" d="M52,104 L74,70 L88,86 L104,60 L120,84 L134,72 L150,104 Z" />
                    <path class="route" d="M66,104 C86,116 112,110 134,120" />
                  </g>

                  <text class="coin__num" x="100" y="140">
                    {s.n}
                  </text>
                  <text class="coin__label" x="100" y="164">
                    ETAPA {s.n}
                  </text>
                </svg>
              </div>
            </>
          ))
        }
      </div>

      {/* Relato + tablero de etapas (secuencia real de 3). */}
      <div class="tour__side">
        <p class="tour__lead">
          Tres carreras, una historia. <b>Cada medalla es una pieza</b>: al correr las tres etapas,
          se enganchan en una sola cadena. La primera vez que Finish Line arma un tour.
        </p>

        <ol class="board" data-reveal data-delay="2">
          {
            stages.map((s) => (
              <li class:list={['board__item', { 'board__item--tbd': s.tbd }]}>
                <span class="board__n">{`Etapa ${s.n}`}</span>
                <p class="board__name">{s.name}</p>
                <p class="board__when">{s.when}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<script>
  // Ensamblado vertical al entrar en viewport: mejora progresiva sobre el estado
  // por defecto (cadena YA armada). Sin JS o con reduced-motion, se ve completa;
  // el movimiento nunca bloquea contenido.
  const chain = document.querySelector<HTMLElement>('.chain');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (chain && !reduce && 'IntersectionObserver' in window) {
    chain.classList.add('motion-armed');
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.35 },
    );
    io.observe(chain);
  }
</script>

<style>
  .tour {
    position: relative;
    overflow: hidden;
    /* Escenario limpio (se quitaron las rayas diagonales del mockup). Viñeteado
       central sutilísimo para asentar el objeto — es luz de escenario, no glow. */
    background:
      radial-gradient(120% 80% at 50% 34%, var(--fl-navy-2), var(--fl-navy) 78%);
    color: var(--fl-cream);
  }
  .rt-defs {
    position: absolute;
  }
  .tour__inner {
    position: relative;
    z-index: 1;
    max-width: var(--fl-container);
    margin: 0 auto;
    padding: clamp(60px, 9vw, 116px) clamp(20px, 5vw, 56px);
  }

  .tour__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
  }
  .tour__kicker {
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--fl-orange);
  }
  .tour__title {
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(26px, 4.4vw, 48px);
    line-height: 0.96;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin: 12px 0 0;
  }
  .tour__badge {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--fl-cream);
    border: 1px solid rgba(246, 240, 228, 0.25);
    padding: 8px 14px;
    align-self: center;
  }

  /* ---- Cuerpo: cadena (objeto) + relato/tablero ---- */
  .tour__body {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(36px, 6vw, 84px);
    align-items: center;
    margin-top: clamp(34px, 5vw, 56px);
  }

  /* ---- Cadena vertical de medallones ---- */
  .chain {
    justify-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .coin {
    width: clamp(132px, 19vw, 184px);
  }
  .coin__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    /* Sombra de contacto muy tenue: profundidad de una pieza física, no glow. */
    filter: drop-shadow(0 14px 22px rgba(0, 0, 0, 0.3));
  }

  .coin__rim {
    fill: none;
    stroke: url(#rt-checker);
    stroke-width: 12;
  }
  .coin__field {
    fill: var(--fl-cream);
  }
  .coin__arc {
    font-family: 'Space Mono', monospace;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 3px;
    fill: var(--fl-navy);
    text-anchor: middle;
  }
  .mtn {
    fill: var(--fl-navy);
  }
  .route {
    fill: none;
    stroke: var(--fl-orange-strong);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 2 6;
  }
  .coin__num {
    font-family: 'Archivo Black', sans-serif;
    font-size: 46px;
    text-anchor: middle;
    dominant-baseline: central;
    fill: var(--fl-navy);
  }
  .coin__label {
    font-family: 'Space Mono', monospace;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 2px;
    text-anchor: middle;
    fill: var(--fl-orange-strong);
  }

  /* Medallón "por definir": moneda vacía en contorno. */
  .coin--tbd .coin__field {
    fill: none;
    stroke: rgba(246, 240, 228, 0.28);
    stroke-width: 2;
    stroke-dasharray: 7 7;
  }
  .coin--tbd .coin__rim {
    opacity: 0.4;
  }
  .coin--tbd .coin__num,
  .coin--tbd .coin__arc {
    fill: var(--fl-on-navy-soft);
  }
  .coin--tbd .coin__label {
    fill: var(--fl-on-navy-soft);
  }
  .coin--tbd .mtn {
    fill: none;
    stroke: var(--fl-on-navy-soft);
    stroke-width: 2;
  }
  .coin--tbd .route {
    stroke: var(--fl-on-navy-soft);
  }
  .coin--tbd .coin__svg {
    filter: none;
  }

  .ck-o {
    fill: var(--fl-orange);
  }
  .ck-n {
    fill: var(--fl-navy);
  }

  /* Eslabones tipo bisagra entre medallones. */
  .link {
    width: 15px;
    height: clamp(16px, 2.4vw, 26px);
    margin: -3px 0;
    background: var(--fl-orange);
    z-index: 2;
  }
  .link--open {
    background: transparent;
    width: 11px;
    border-left: 2px dashed rgba(246, 240, 228, 0.3);
    border-right: 2px dashed rgba(246, 240, 228, 0.3);
  }

  /* ---- Relato + tablero ---- */
  .tour__lead {
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.5;
    color: var(--fl-on-navy-soft);
    max-width: 42ch;
    text-wrap: pretty;
    margin: 0;
  }
  .tour__lead b {
    color: var(--fl-cream);
  }

  .board {
    list-style: none;
    margin: clamp(26px, 3.5vw, 40px) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 2vw, 20px);
  }
  .board__item {
    padding-top: 15px;
    border-top: 2px solid var(--fl-orange);
  }
  .board__item--tbd {
    border-top-color: rgba(246, 240, 228, 0.22);
  }
  .board__n {
    display: inline-block;
    font-family: 'Space Mono', monospace;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--fl-navy-3);
    background: var(--fl-orange);
    padding: 6px 9px;
  }
  .board__item--tbd .board__n {
    background: transparent;
    color: var(--fl-on-navy-soft);
    border: 1px solid rgba(246, 240, 228, 0.28);
  }
  .board__name {
    margin: 12px 0 0;
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-size: clamp(15px, 2vw, 18px);
    color: var(--fl-cream);
  }
  .board__when {
    margin: 5px 0 0;
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--fl-on-navy-soft);
  }

  @media (max-width: 860px) {
    .tour__body {
      grid-template-columns: 1fr;
      gap: clamp(32px, 7vw, 48px);
      justify-items: center;
    }
    .tour__side {
      width: 100%;
      max-width: 520px;
    }
    .tour__lead {
      text-align: center;
      max-width: none;
    }
  }

  /* ================= MOTION: ensamblado vertical al entrar ================= */
  /* Estado inicial sólo con JS (`.motion-armed`); sin JS = cadena ya armada. */
  .chain.motion-armed .coin {
    opacity: 0;
    transform: translateY(-26px) scale(0.92);
  }
  .chain.motion-armed .link {
    opacity: 0;
    transform: scaleY(0);
    transform-origin: top;
  }

  .chain.motion-armed.is-in .coin {
    opacity: 1;
    transform: none;
    transition:
      transform 0.6s var(--ease-out),
      opacity 0.5s var(--ease-out);
  }
  .chain.motion-armed.is-in .coin--tbd {
    opacity: 0.55;
  }
  .chain.motion-armed.is-in .link {
    opacity: 1;
    transform: scaleY(1);
    transition:
      transform 0.35s var(--ease-out),
      opacity 0.3s var(--ease-out);
  }
  /* Caen y encajan de arriba hacia abajo; los eslabones traban después del
     medallón de arriba. nth-of-type cuenta por tag: .coin son <div>, .link son
     <span>, cada uno con su propio índice de tipo. */
  .chain.motion-armed.is-in .coin:nth-of-type(1) {
    transition-delay: 0s;
  }
  .chain.motion-armed.is-in .link:nth-of-type(1) {
    transition-delay: 0.2s;
  }
  .chain.motion-armed.is-in .coin:nth-of-type(2) {
    transition-delay: 0.28s;
  }
  .chain.motion-armed.is-in .link:nth-of-type(2) {
    transition-delay: 0.48s;
  }
  .chain.motion-armed.is-in .coin:nth-of-type(3) {
    transition-delay: 0.56s;
  }

  .coin--tbd {
    opacity: 0.55;
  }

  @media (prefers-reduced-motion: reduce) {
    .chain.motion-armed .coin,
    .chain.motion-armed .link {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .chain.motion-armed .coin--tbd {
      opacity: 0.55;
    }
  }
</style>
