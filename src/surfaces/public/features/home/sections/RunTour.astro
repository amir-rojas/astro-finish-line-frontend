---
// RunTour — MÓDULO 2 de la home: banda de la serie "Run Tour Finish Line".
//
// Concepto (rediseño 2026-07-06, tras ver la medalla REAL en
// design-reference/renacer-medalla.png): NO es una medalla partida en piezas. Cada
// carrera del tour entrega su PROPIA medalla completa (una placa vertical:
// banner-nombre arriba, escena grabada al centro, "RUN TOUR FINISH LINE" abajo) y
// las medallas traen DIENTES DE ENCASTRE en el costado: al completar las tres,
// encajan lateralmente y forman una sola pieza. Ese es el meta-logro real.
//
// Dirección elegida por Amir: HÍBRIDO Tour de los Elementos (una card de identidad
// por etapa, con estado de avance) + runDisney (galería donde la MEDALLA real es el
// objeto-héroe de cada card). Ref: design-reference/tour-elementos.png +
// disney-medals-reference.jpeg.
//
// Estado de datos (hardcodeado; Strapi aún no modela la serie):
//  - Etapa 1 = RENACER, DESBLOQUEADA, con foto de la medalla real y link al detalle
//    (`/calendario/renacer` — la Carrera en Strapi debe existir con ese slug).
//  - Etapa 2 = fecha firme, nombre por revelar. Etapa 3 = todo por revelar.
//    Las siluetas llevan los dientes según su posición en la cadena: la del medio
//    encastra por AMBOS lados; la tercera, por la izquierda.
//
// Sin progreso "personal" ("Tu avance"): el visitante puede no estar inscrito y no
// hay cuentas — el estado es de la SERIE, y lo cuentan el badge y los candados.
//
// Registro FILOSO fiel a DESIGN.md: sin glow/glass.
//
// Sección NAVY-2 (decisión Amir 2026-07-09). Fue crema entre 2026-07-08 y hoy: la
// premisa de entonces era "entre Hero y Price, ambos navy, el crema restaura la
// alternancia". Price salió de la home, y el vecino de abajo pasó a ser Recaps
// (crema-2): el crema ya no alternaba con nada, dejaba tres secciones claras
// seguidas y hacía desaparecer el borde con Recaps. `--fl-navy-2` existe en el
// sistema exactamente para esto y no lo usaba nadie.
//
// Sobre navy la medalla —una toma de estudio con fondo oscuro— deja de pelear con
// el papel. Cards en navy profundo; las bloqueadas se funden con el fondo de la
// sección: el misterio ahora es sombra, no papel apagado. El diente del medio pasa
// de navy a crema (sobre navy, un cuadro navy no existe).
//
// Copy en español neutro de Bolivia — SIN voseo.
import { Image } from 'astro:assets';
import renacerMedal from '../../../../../assets/medals/renacer.png';

const stages = [
  {
    n: 1,
    name: 'Renacer',
    when: '16 AGO 2026',
    locked: false,
    medal: renacerMedal,
    href: '/calendario/renacer',
  },
  { n: 2, name: 'Nombre por revelar', when: '25 OCT 2026', locked: true, medal: null, href: null },
  { n: 3, name: 'Por revelar', when: 'Fecha por definir', locked: true, medal: null, href: null },
];

// Silueta de la placa por posición en la cadena: dientes de encastre a ambos lados
// (etapa del medio) o sólo a la izquierda (última). Notches a la misma altura que
// los de la vecina, para que se lea que son el mismo encastre.
const ghostPaths: Record<string, string> = {
  both: 'M40,40 h120 v18 l-14,10 14,10 v14 l-14,10 14,10 v88 h-120 v-18 l14,-10 -14,-10 v-14 l14,-10 -14,-10 Z',
  left: 'M40,40 h120 v160 h-120 v-88 l14,-10 -14,-10 v-14 l14,-10 -14,-10 v-18 Z',
};

const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="run-tour" class="tour">
  <div class="tour__inner">
    <header class="tour__head">
      <div>
        <p class="tour__kicker" data-reveal>// La serie</p>
        <h2 class="tour__title" data-reveal data-delay="1">Run Tour Finish Line</h2>
      </div>
      <span class="tour__badge" data-reveal data-delay="1">1ª edición · 3 etapas</span>
    </header>

    <p class="tour__lead" data-reveal data-delay="2">
      Cada etapa entrega su propia medalla, y las tres traen dientes que <b>encajan entre sí</b>.
      Completa el Run Tour y las medallas se unen en una sola pieza: el símbolo de la serie.
    </p>

    {/* Riel de cards: la medalla es la protagonista. Entre cards van los DIENTES
        de encastre (cuadros de meta) que cuentan que las medallas se enganchan.
        El estado de la serie lo dicen el badge (3 etapas) y los candados — sin
        barra de "avance" personal (no hay cuentas; sería un estado falso). */}
    <div class="rail">
      {
        stages.map((s, i) => (
          <Fragment>
            {i > 0 && (
              <span class="teeth" data-reveal data-delay={i === 1 ? '1' : '2'} aria-hidden="true">
                <span class="teeth__t" /><span class="teeth__t" /><span class="teeth__t" />
              </span>
            )}
            <article
              class:list={['card', { 'card--locked': s.locked, 'card--link': !!s.href }]}
              data-reveal
              data-delay={i === 0 ? '1' : i === 1 ? '2' : '3'}
            >
              <div class="card__top">
                <span class="card__stage">Etapa {pad(s.n)}</span>
                <span class="card__state">
                  {s.locked ? (
                    <>
                      <svg class="card__lock" viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="4.5" y="10.5" width="15" height="10" />
                        <path d="M8,10.5 V7.5 a4,4 0 0 1 8,0 V10.5" />
                      </svg>
                      Por desbloquear
                    </>
                  ) : (
                    <>
                      <span class="card__dot" aria-hidden="true" />
                      Desbloqueada
                    </>
                  )}
                </span>
              </div>

              <div class:list={['card__stage-vis', { 'card__stage-vis--photo': !s.locked && !!s.medal }]}>
                {!s.locked && s.medal ? (
                  <Image
                    class="card__medal"
                    src={s.medal}
                    alt={`Medalla ${s.name} — Run Tour Finish Line`}
                    widths={[280, 460, 620, 760]}
                    sizes="(max-width: 860px) 94vw, 360px"
                    loading="lazy"
                  />
                ) : (
                  /* Placeholder: silueta de la placa real (banner arriba, cuerpo,
                     banner abajo) + candado. Misterio, no vacío. Los dientes van
                     según la posición: la del medio encastra por ambos lados. */
                  <svg class="card__ghost" viewBox="0 0 200 260" aria-hidden="true">
                    <path class="ghost__stroke" d={i === 1 ? ghostPaths.both : ghostPaths.left} />
                    <rect class="ghost__stroke" x="30" y="30" width="140" height="30" />
                    <rect class="ghost__stroke" x="46" y="196" width="108" height="26" />
                    <g class="ghost__lock">
                      <rect x="86" y="120" width="28" height="20" />
                      <path d="M92,120 V113 a8,8 0 0 1 16,0 V120" />
                    </g>
                  </svg>
                )}
              </div>

              <div class="card__foot">
                <span class:list={['card__name', { 'card__name--tbd': s.locked }]}>{s.name}</span>
                <span class="card__when">{s.when}</span>
                {s.href && (
                  <a class="card__cta" href={s.href}>
                    Conoce la carrera <span class="card__cta-arr" aria-hidden="true">→</span>
                  </a>
                )}
              </div>
            </article>
          </Fragment>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tour {
    position: relative;
    overflow: hidden;
    /* Papel claro con viñeteado sutil hacia cream-2: escenario de vitrina para la
       medalla.

       SIN `min-height: 100vh`. Lo tenía, centrado con flex, para ocupar la
       pantalla como el Hero. Pero el Hero tiene una foto que llena y esta
       sección tiene tres tarjetas: en un monitor de 1440 de alto el centrado
       agregaba 247px de vacío ARRIBA Y ABAJO del padding, y en móvil no hacía
       nada (el contenido ya supera el viewport). El respiro sale del padding de
       `.tour__inner`, que es el mismo que el de Recaps. */
    /* Viñeteado hacia el navy del lienzo: la vitrina se ilumina al centro, donde
       está la medalla. Mismo gesto que tenía en crema, invertido. */
    background: radial-gradient(120% 82% at 50% 34%, var(--fl-navy-2), var(--fl-navy) 88%);
    color: var(--fl-cream);
  }
  .tour__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--fl-container);
    margin: 0 auto;
    padding: clamp(60px, 7vw, 96px) clamp(20px, 5vw, 56px);
  }

  /* ---- Cabecera ---- */
  .tour__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
  }
  .tour__kicker {
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    /* Eyebrow con prefijo // como en Recorrido. Sobre navy-2, `on-navy-muted` da
       4.77:1 a 12px bold: pasa AA con poco margen. No bajarlo. */
    color: var(--fl-on-navy-muted);
  }
  .tour__title {
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(26px, 4.4vw, 48px);
    line-height: 0.96;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-wrap: balance;
    margin: 12px 0 0;
  }
  .tour__badge {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--fl-cream);
    border: 1px solid var(--fl-edge);
    padding: 8px 14px;
    /* Alineado a la línea base del título (el header ya alinea flex-end):
       el badge deja de flotar sin referencia. */
    align-self: flex-end;
  }

  /* ---- Relato del encastre ---- */
  .tour__lead {
    margin: clamp(26px, 4vw, 40px) 0 0;
    max-width: 62ch;
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.55;
    color: var(--fl-on-navy-soft);
    text-wrap: pretty;
  }
  .tour__lead b {
    color: var(--fl-cream);
  }

  /* ---- Riel de cards ---- */
  .rail {
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: 0;
    margin-top: clamp(34px, 5vw, 56px);
  }
  .card {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    max-width: 360px;
    display: flex;
    flex-direction: column;
    /* Navy profundo sobre la vitrina navy-2: la card se lee como objeto por ser
       MÁS oscura que el fondo, no más clara. Una card blanca acá sería un agujero
       de luz que le robaría la escena a la medalla. */
    background: var(--fl-navy-3);
    border: 1px solid var(--fl-hairline);
  }
  .card--link {
    border-color: var(--fl-edge);
    transition:
      border-color 0.18s ease-out,
      transform 0.18s ease-out;
  }
  .card--link:hover {
    border-color: var(--fl-on-navy-soft);
    transform: translateY(-3px);
  }
  .card--locked {
    /* Se funde con el fondo de la sección: el misterio es sombra, no papel
       apagado. La silueta punteada es casi lo único que la delata. */
    background: transparent;
    border-color: var(--fl-hairline);
  }

  .card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--fl-hairline);
  }
  .card__stage {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--fl-cream);
  }
  .card--locked .card__stage {
    color: var(--fl-on-navy-muted);
  }
  .card__state {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'Space Mono', monospace;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    /* Texto en crema (el naranja a este tamaño no pasa AA sobre navy);
       el acento naranja lo pone el dot. */
    color: var(--fl-cream);
    white-space: nowrap;
  }
  .card--locked .card__state {
    color: var(--fl-on-navy-muted);
  }
  .card__dot {
    width: 7px;
    height: 7px;
    background: var(--fl-orange);
  }
  .card__lock {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: var(--fl-on-navy-muted);
    stroke-width: 1.8;
  }
  .card__lock rect {
    fill: var(--fl-on-navy-muted);
    stroke: none;
  }

  /* ---- Escenario visual (medalla / placeholder) ---- */
  .card__stage-vis {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(18px, 2.4vw, 26px);
    aspect-ratio: 1 / 1;
  }
  /* La foto real es una toma de ESTUDIO (fondo oscuro, cinta, sombra propia), no
     un recorte con alpha: va a sangre como imagen enmarcada (DESIGN.md: frames de
     proporción fija, esquinas rectas), no fingiendo flotar sobre la card blanca. */
  .card__stage-vis--photo {
    padding: 0;
  }
  .card__medal {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card__ghost {
    width: 62%;
    height: auto;
    opacity: 0.8;
  }
  .ghost__stroke {
    fill: none;
    stroke: rgba(246, 240, 228, 0.34);
    stroke-width: 2;
    stroke-dasharray: 7 7;
  }
  .ghost__lock rect {
    fill: none;
    stroke: var(--fl-on-navy-muted);
    stroke-width: 2.4;
  }
  .ghost__lock path {
    fill: none;
    stroke: var(--fl-on-navy-muted);
    stroke-width: 2.4;
  }

  /* ---- Pie de card ---- */
  .card__foot {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px;
    border-top: 1px solid var(--fl-hairline);
  }
  .card__name {
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(20px, 2.6vw, 26px);
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--fl-cream);
  }
  .card__name--tbd {
    font-family: 'Space Mono', monospace;
    font-size: 15px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--fl-on-navy-muted);
  }
  .card__when {
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--fl-on-navy-muted);
  }

  /* CTA de la card desbloqueada: link estirado (cubre toda la card) con
     affordance visible en el pie. */
  .card__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--fl-cream);
    touch-action: manipulation;
  }
  .card__cta::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card__cta:focus-visible {
    outline: none;
  }
  .card:has(.card__cta:focus-visible) {
    outline: 2px solid var(--fl-orange);
    outline-offset: 3px;
  }
  .card__cta-arr {
    transition: transform 0.18s ease-out;
  }
  .card--link:hover .card__cta-arr {
    transform: translateX(4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .card--link,
    .card__cta-arr {
      transition: none;
    }
    .card--link:hover {
      transform: none;
    }
    .card--link:hover .card__cta-arr {
      transform: none;
    }
  }

  /* ---- Dientes de encastre entre cards ---- */
  .teeth {
    flex: 0 0 auto;
    align-self: center;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 0 clamp(4px, 1vw, 10px);
    z-index: 2;
  }
  .teeth__t {
    width: 12px;
    height: 12px;
    background: var(--fl-orange);
  }
  .teeth__t:nth-child(2) {
    /* Cuadro alterno crema: el damero de la bandera de meta. Sobre navy el
       cuadro navy no existiría; sobre el crema anterior era al revés. */
    background: var(--fl-cream);
  }

  /* ---- Responsive: apilado en móvil, dientes horizontales en la costura ---- */
  @media (max-width: 860px) {
    .rail {
      flex-direction: column;
      align-items: stretch;
      max-width: 420px;
      margin-left: auto;
      margin-right: auto;
    }
    .card {
      max-width: none;
    }
    .card__stage-vis {
      aspect-ratio: 16 / 10;
    }
    .teeth {
      flex-direction: row;
      align-self: center;
      padding: clamp(4px, 2vw, 10px) 0;
    }
  }
</style>
