---
// RunTour — MÓDULO 2 de la home: banda de identidad de la serie "Run Tour
// Finish Line". Es branding permanente, NO event-driven: título, badge, medallas
// que se conectan y la narrativa son copy de marca, no dato del CMS.
//
// Las 3 etapas están HARDCODEADAS a propósito (decisión de Amir, sesión
// 2026-07-06): hoy Strapi tiene 1 sola carrera del tour y el content type no
// puede agrupar carreras en una serie ni marcar nº de etapa. Se cablea a datos
// cuando exista el modelo de tour. Fuente visual: design-reference/mockup-home.html.
//
// `stages`: las etapas de la 1ª edición. `tbd` marca la etapa sin fecha aún.
const stages = [
  { n: 'Etapa 1', name: 'Run Tour Finish Line · Etapa 1', when: '16 AGO 2026', tbd: false },
  { n: 'Etapa 2', name: 'Run Tour Finish Line · Etapa 2', when: '25 OCT 2026', tbd: false },
  { n: 'Etapa 3 · Final', name: 'Run Tour Finish Line · Gran Final', when: 'Por definir', tbd: true },
];
---

<section class="tour">
  <div class="tour__inner">
    <div class="tour__head">
      <div>
        <p class="tour__kicker" data-reveal>La serie</p>
        <h2 class="tour__title" data-reveal data-delay="1">Run Tour<br />Finish Line</h2>
      </div>
      <span class="tour__badge" data-reveal data-delay="1">1ª edición · 3 etapas</span>
    </div>

    <div class="tour__body">
      <div data-reveal data-delay="2">
        <div class="medals" aria-hidden="true">
          <div class="medal">1</div>
          <div class="medal">2</div>
          <div class="medal medal--tbd">3</div>
        </div>
        <p class="medals__cap">Completá las 3 etapas<br />y armá la medalla del tour</p>
        <p class="tour__lead">
          Tres carreras, una historia. <b>Cada medalla es una pieza</b>: corré las tres etapas y
          encajan en una sola. La primera vez que Finish Line arma un tour.
        </p>
      </div>

      <ul class="stages" data-reveal data-delay="3">
        {
          stages.map((s) => (
            <li class:list={['stage', { 'stage--tbd': s.tbd }]}>
              <span class="stage__n">{s.n}</span>
              <span class="stage__name">{s.name}</span>
              <span class="stage__when">{s.when}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .tour {
    position: relative;
    overflow: hidden;
    background: var(--fl-navy-2);
    color: var(--fl-cream);
  }
  /* Trama diagonal sutil: mismo lenguaje de "franjas de pista" del surface. */
  .tour::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: repeating-linear-gradient(
      -115deg,
      rgba(246, 240, 228, 0.045) 0 2px,
      transparent 2px 54px
    );
  }
  .tour__inner {
    position: relative;
    z-index: 1;
    max-width: var(--fl-container);
    margin: 0 auto;
    padding: clamp(52px, 7vw, 88px) clamp(20px, 5vw, 56px);
  }

  .tour__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
  }
  .tour__kicker {
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--fl-orange);
  }
  .tour__title {
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(30px, 5vw, 54px);
    line-height: 0.96;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin: 12px 0 0;
  }
  .tour__badge {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--fl-cream);
    border: 1px solid rgba(246, 240, 228, 0.25);
    padding: 8px 14px;
    align-self: center;
  }

  .tour__body {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr);
    gap: clamp(30px, 5vw, 60px);
    margin-top: clamp(30px, 4.5vw, 48px);
    align-items: center;
  }
  .tour__lead {
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.5;
    color: var(--fl-on-navy-soft);
    max-width: 42ch;
    text-wrap: pretty;
    margin: 22px 0 0;
  }
  .tour__lead b {
    color: var(--fl-cream);
  }

  /* Medallas que se conectan: se superponen levemente para leerse como piezas
     de una sola. La tercera es "por definir" (trama rayada). */
  .medals {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 26px 0 6px;
  }
  .medal {
    width: clamp(64px, 12vw, 92px);
    height: clamp(64px, 12vw, 92px);
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #ffb98f, var(--fl-orange-strong) 60%, #b83a08);
    border: 3px solid var(--fl-cream);
    display: grid;
    place-items: center;
    font-family: 'Archivo Black', sans-serif;
    color: var(--fl-navy-3);
    font-size: clamp(20px, 3.5vw, 28px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
    position: relative;
  }
  .medal + .medal {
    margin-left: clamp(-16px, -2.4vw, -12px);
  }
  .medal--tbd {
    background: repeating-linear-gradient(45deg, #2a3f5c 0 6px, #23374f 6px 12px);
    color: var(--fl-on-navy-soft);
  }
  .medals__cap {
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--fl-on-navy-muted);
    text-align: center;
  }

  .stages {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .stage {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 16px 18px;
    background: rgba(246, 240, 228, 0.05);
  }
  .stage__n {
    font-family: 'Space Mono', monospace;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--fl-navy-3);
    background: var(--fl-orange);
    padding: 6px 9px;
    white-space: nowrap;
  }
  .stage--tbd .stage__n {
    background: transparent;
    color: var(--fl-on-navy-muted);
    border: 1px solid rgba(246, 240, 228, 0.22);
  }
  .stage__name {
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-size: clamp(15px, 2vw, 18px);
  }
  .stage__when {
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--fl-on-navy-soft);
    white-space: nowrap;
  }
  .stage--tbd .stage__when {
    color: var(--fl-on-navy-muted);
  }

  @media (max-width: 820px) {
    .tour__body {
      grid-template-columns: 1fr;
    }
  }
</style>
