---
// PublicLayout — chrome de la SUPERFICIE pública (todo lo de cara al usuario:
// home/landing, eventos, inscripción, resultados...). Compone sobre BaseLayout
// (el shell <html> con metas compartidas) y aplica el lenguaje visual público:
// fuentes Archivo / Archivo Black / Space Mono, lienzo navy y color crema.
// El panel admin usa su propio AdminLayout; nunca se mezclan.
import BaseLayout from '@shared/layouts/BaseLayout.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/public.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogUrl?: string;
  canonical?: string;
}
const { title, description, ogImage, ogUrl, canonical } = Astro.props;
---

<BaseLayout {title} {description} {ogImage} {ogUrl} {canonical}>
  {/* Fuentes propias del surface público, inyectadas en el <head> del shell. */}
  <Fragment slot="head">
    {/* Transiciones entre páginas. Va acá y no en BaseLayout para no arrastrar el
        router al panel admin: navegar público→admin cae a full reload, que es lo
        correcto. Astro desactiva sus animaciones con `prefers-reduced-motion`. */}
    <ClientRouter />
    {/* preconnect a fonts.googleapis.com / fonts.gstatic.com ya vive en BaseLayout */}
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=Archivo+Black&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    {/* Cada página puede inyectar metas/JSON-LD extra en el <head> del shell. */}
    <slot name="head" />
  </Fragment>

  <div data-surface="public" class="public-surface">
    <slot />
  </div>
</BaseLayout>

<script>
  // Revelado al entrar en viewport. Solo se activa con JS y si el usuario no
  // pidió reducir movimiento: por defecto el contenido es visible (no-JS safe).
  //
  // Corre en `astro:page-load`, que dispara en la carga inicial y después de
  // cada navegación del ClientRouter. El observer anterior se desconecta en
  // `astro:before-swap`: sin eso, cada navegación dejaría uno vivo observando
  // nodos que ya no están en el documento.
  let io: IntersectionObserver | null = null;

  function initReveal() {
    const root = document.querySelector<HTMLElement>('.public-surface');
    const allowMotion = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
    if (!root || !allowMotion || !('IntersectionObserver' in window)) return;

    root.classList.add('reveal-ready');
    io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io?.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.12 },
    );
    const els = Array.from(root.querySelectorAll<HTMLElement>('[data-reveal]'));
    // Doble rAF: se pinta el estado oculto y recién después se revela, para que
    // la transición corra. Lo que ya está en la primera pantalla (hero completo,
    // incluido el contador al borde inferior) entra al cargar; el resto, al scroll.
    requestAnimationFrame(() =>
      requestAnimationFrame(() => {
        for (const el of els) {
          const rect = el.getBoundingClientRect();
          const inView = rect.top < window.innerHeight && rect.bottom > 0;
          if (inView) el.classList.add('is-in');
          else io?.observe(el);
        }
      }),
    );
  }

  document.addEventListener('astro:page-load', initReveal);
  document.addEventListener('astro:before-swap', () => {
    io?.disconnect();
    io = null;
  });
</script>

<style>
  .public-surface {
    --fl-navy: #0e1c30;
    --fl-navy-2: #142944; /* banda navy apenas más clara (p.ej. Run Tour), separa de secciones navy contiguas */
    --fl-navy-3: #0a1525; /* navy más profundo: texto oscuro sobre acentos claros (medallas, badges) */
    --fl-ink: #14233a;
    --fl-orange: #ee5314; /* acento de marca: mark, motivos, foco (no texto blanco encima) */
    --fl-orange-strong: #cf3f0d; /* naranja para superficies con texto blanco: 4.8:1 AA */
    --fl-orange-hover: #b8380b; /* hover de CTAs primarios (texto blanco) */
    --fl-cream: #f6f0e4;
    --fl-cream-2: #efe7d6;
    --fl-cream-3: #e1d6bd;
    --fl-surface: #ffffff;
    /* Neutrales derivados (contraste verificado): texto/meta sobre navy y crema. */
    --fl-on-navy-soft: #aebbcb;
    --fl-on-navy-muted: #8295aa;
    --fl-on-cream-muted: #5a5346;
    --fl-on-cream-faint: #9a8f78;

    /* Crema y naranja con alfa, SOBRE NAVY. No son colores nuevos: son los de
       marca a baja opacidad, y se escribían a mano —`rgba(246, 240, 228, .12)`—
       en el header, el hero, el precio y el footer. Un token por rol, no por
       valor: si la divisoria tiene que respirar más, se cambia acá. */
    --fl-hairline: rgba(246, 240, 228, 0.12); /* divisorias entre bloques */
    --fl-edge: rgba(246, 240, 228, 0.18); /* borde de chips y botones ghost */
    --fl-wash-orange: rgba(238, 83, 20, 0.1); /* fondo de hover sobre navy */

    /* ESTADO DE INSCRIPCIÓN — extensión funcional deliberada, FUERA del ramp de
       marca. El semáforo verde/ámbar/gris es una convención universal y el
       usuario escanea el listado con ella; la marca (navy/crema/naranja) no
       tiene un tercer acento para codificar urgencia, y el naranja ya significa
       "inscribirse". No usar estos tokens para nada que no sea estado.
       Contraste con texto blanco verificado (mínimo AA a 11px bold). */
    --fl-status-open: #1f7a4d; /* rellenos sobre crema; blanco encima: 5.32:1 */
    --fl-status-warning: #a15c00; /* blanco encima: 5.19:1 */
    --fl-status-closed: #52525b; /* blanco encima: 7.73:1 */
    --fl-status-open-ink: #8ee0ac; /* tinta/borde sobre navy: 10.92:1 */

    --fl-container: 1180px;

    background: var(--fl-navy);
    color: var(--fl-cream);
    font-family: 'Archivo', system-ui, sans-serif;
    /* `clip` recorta el desborde horizontal SIN crear contenedor de scroll;
       `hidden` forzaría overflow-y:auto y rompería el position:sticky del header. */
    overflow-x: clip;
  }
</style>
