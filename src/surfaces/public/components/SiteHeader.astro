---
// Header GLOBAL de la superficie pública. Lo usan la home, /calendario y el
// detalle de carrera. Reemplaza al SiteHeader de `features/home` (nav de anclas,
// event-driven) y al CalendarHeader (sin nav) — el sitio dejó de ser una landing
// de un solo evento y pasó a ser el sitio de un organizador con muchas carreras.
//
// Nav de tres destinos, todos válidos desde CUALQUIER ruta:
//  · /calendario   → ruta real
//  · /#run-tour    → ancla root-relative: navega a la home y baja
//  · /#recaps      → idem
// Un `#run-tour` pelado solo resolvía en `/`; desde el detalle de una carrera
// era un link muerto.
//
// SIN CTA de inscripción: no existe "la" inscripción, existe la de cada carrera
// y vive en su página de detalle (modelo NYRR).
//
// `Calendario` va ÚLTIMO y con cuerpo de botón. No porque "sea el que navega"
// (desde el detalle de una carrera los tres navegan), sino por JERARQUÍA: quien
// entra al sitio de un organizador viene a encontrar una carrera. Que pesara lo
// mismo que "Así se vivió", que es branding, era el error.
//
// El bloque es crema sólido, no naranja: el naranja se reserva para la
// conversión real ("Inscribirse", en el detalle). Y sin `border-radius`: el pill
// de la referencia (NYRR) rompe el registro filoso de DESIGN.md, y su relleno
// —un navy apenas más claro— daría 1.17:1 acá, invisible.
import BrandIsotype from './BrandIsotype.astro';

const path = Astro.url.pathname;
/** Ruta actual: `/calendario` y `/calendario/lo-que-sea` marcan el mismo ítem. */
const isCalendar = path === '/calendario' || path.startsWith('/calendario/');

const nav = [
  { href: '/#run-tour', label: 'Run Tour', current: false, cta: false },
  { href: '/#recaps', label: 'Así se vivió', current: false, cta: false },
  { href: '/calendario', label: 'Calendario', current: isCalendar, cta: true },
];
---

<a class="skip" href="#contenido">Saltar al contenido</a>

{/* `transition:name` lo saca del cross-fade del documento y `animate="none"` lo
    intercambia sin animar: el header no parpadea al navegar. NO se usa
    `transition:persist` a propósito — persistir conserva el DOM viejo, y con él
    un `aria-current` de la página anterior. */}
<header class="hd" transition:name="site-header" transition:animate="none">
  <div class="hd__inner">
    <a href="/" class="brand" aria-label="Finish Line — inicio">
      <span class="brand__iso"><BrandIsotype /></span>
      <span class="brand__word">FINISH LINE</span>
    </a>

    <span class="hd__rule" aria-hidden="true"></span>

    <nav class="nav" aria-label="Secciones">
      {
        nav.map((s) => (
          <a
            class:list={[s.cta && 'nav__cta']}
            href={s.href}
            aria-current={s.current ? 'page' : undefined}
          >
            {s.label}
          </a>
        ))
      }
    </nav>

    {/* Disclosure de secciones para móvil. Funciona sin JS (details/summary);
        el script solo lo cierra al elegir, con Escape o al tocar fuera. */}
    <details class="menu">
      <summary class="burger" aria-expanded="false" aria-label="Secciones">
        <span class="burger__box" aria-hidden="true">
          <span class="burger__bar"></span>
        </span>
      </summary>
      <nav class="menu__panel" aria-label="Secciones">
        {
          nav.map((s) => (
            <a
              class:list={[s.cta && 'menu__cta']}
              href={s.href}
              aria-current={s.current ? 'page' : undefined}
            >
              {s.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>

<script>
  // `astro:page-load` corre en la carga inicial Y después de cada navegación del
  // ClientRouter. Sin esto, el header se reemplaza al navegar y el menú móvil
  // queda sin listeners: se abre pero no cierra.
  function initMenu() {
    const details = document.querySelector<HTMLDetailsElement>('.hd .menu');
    if (!details) return;
    const summary = details.querySelector<HTMLElement>('summary');
    const panel = details.querySelector<HTMLElement>('.menu__panel');

    panel?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) details.open = false;
    });
    details.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && details.open) {
        details.open = false;
        summary?.focus();
      }
    });
    // Va sobre `document`, que sobrevive al swap: se registra una sola vez.
    details.addEventListener('toggle', () => {
      summary?.setAttribute('aria-expanded', String(details.open));
    });
  }

  // El click-fuera se ata a `document` una única vez y busca el <details> vivo
  // en cada evento, en vez de capturar el de la primera carga.
  document.addEventListener('click', (e) => {
    const details = document.querySelector<HTMLDetailsElement>('.hd .menu');
    if (details?.open && !details.contains(e.target as Node)) details.open = false;
  });

  document.addEventListener('astro:page-load', initMenu);
</script>

<style>
  /* Primer foco tabulable de la página: invisible hasta que se enfoca. */
  .skip {
    position: fixed;
    top: 0;
    left: 0;
    z-index: var(--z-skip);
    transform: translateY(-110%);
    padding: 12px 18px;
    background: var(--fl-cream);
    color: var(--fl-navy);
    font-family: 'Space Mono', monospace;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }
  .skip:focus-visible {
    transform: translateY(0);
    outline: 2px solid var(--fl-orange);
    outline-offset: -4px;
  }

  .hd {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: rgba(14, 28, 48, 0.94);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--fl-hairline);
  }
  .hd__inner {
    max-width: var(--fl-container);
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 56px);
    min-height: var(--fl-header-h, 74px);
    display: flex;
    align-items: center;
    gap: clamp(18px, 3vw, 36px);
  }

  /* Regla vertical: separa identidad de navegación. Hairline, no borde. */
  .hd__rule {
    align-self: stretch;
    width: 1px;
    background: var(--fl-hairline);
    flex-shrink: 0;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    flex-shrink: 0;
  }
  .brand:focus-visible {
    outline: 2px solid var(--fl-orange);
    outline-offset: 4px;
  }
  /* El isotipo es ancho (ratio ~2.2:1): se dimensiona por ALTO. */
  .brand__iso {
    display: block;
    height: 42px;
  }
  .brand__word {
    font-family: 'Archivo Black', sans-serif;
    font-size: 22px;
    letter-spacing: 1px;
    color: var(--fl-cream);
  }

  .nav {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: clamp(20px, 2.4vw, 32px);
    font-family: 'Space Mono', monospace;
    font-size: 14px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  /* 44px de alto: WCAG 2.2 SC 2.5.8 pide 24×24 como mínimo; el padding también
     da al link un área de clic real, no solo la caja del texto. */
  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 2px;
    color: var(--fl-on-navy-soft);
    text-decoration: none;
    text-underline-offset: 8px;
    text-decoration-thickness: 2px;
    transition: color 160ms var(--ease-out);
  }
  .nav a:hover {
    color: var(--fl-cream);
  }
  .nav a:focus-visible {
    outline: 2px solid var(--fl-orange);
    outline-offset: 4px;
  }
  /* Página actual, para los links de sección. */
  .nav a[aria-current='page']:not(.nav__cta) {
    color: var(--fl-cream);
    text-decoration: underline;
    text-decoration-color: var(--fl-orange);
  }

  /* Destino primario. Crema sólido sobre navy = 15.07:1. Sin radius.
     Se escribe `.nav a.nav__cta` porque `.nav a` es más específico que
     `.nav__cta` a secas y le ganaría el color. */
  .nav a.nav__cta {
    padding: 0 24px;
    background: var(--fl-cream);
    color: var(--fl-navy);
    font-weight: 700;
    transition:
      background-color 160ms var(--ease-out),
      color 160ms var(--ease-out);
  }
  .nav a.nav__cta:hover {
    background: var(--fl-surface);
    color: var(--fl-navy);
  }
  /* Ya estás en el calendario: barra naranja embutida, no un color distinto
     (el relleno crema ya carga toda la jerarquía). */
  .nav a.nav__cta[aria-current='page'] {
    box-shadow: inset 0 -4px 0 var(--fl-orange);
  }

  /* --- Disclosure móvil --------------------------------------------------- */
  .menu {
    display: none; /* se muestra solo en móvil */
    /* Sin position propia: el panel absolute se ancla al header (.hd, sticky),
       no al <details>, para abarcar el ancho completo y no aplastarse. */
  }
  .burger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    cursor: pointer;
    list-style: none;
    color: var(--fl-cream);
    -webkit-tap-highlight-color: transparent;
  }
  .burger::-webkit-details-marker {
    display: none;
  }
  .burger:focus-visible {
    outline: 2px solid var(--fl-orange);
    outline-offset: 2px;
  }
  .burger__box {
    position: relative;
    width: 22px;
    height: 14px;
  }
  /* Tres trazos con ::before / ::after; el del medio es .burger__bar. */
  .burger__bar,
  .burger__box::before,
  .burger__box::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    transition:
      transform 200ms var(--ease-out),
      opacity 160ms var(--ease-out);
  }
  .burger__box::before {
    top: 0;
  }
  .burger__bar {
    top: 6px;
  }
  .burger__box::after {
    bottom: 0;
  }
  /* Estado abierto: el burger se convierte en una X. */
  .menu[open] .burger__box::before {
    transform: translateY(6px) rotate(45deg);
  }
  .menu[open] .burger__bar {
    opacity: 0;
  }
  .menu[open] .burger__box::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  .menu__panel {
    position: absolute;
    top: 100%;
    right: clamp(20px, 5vw, 56px);
    left: clamp(20px, 5vw, 56px);
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px;
    background: var(--fl-navy);
    border: 1px solid var(--fl-hairline);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.4);
  }
  .menu__panel a {
    font-family: 'Space Mono', monospace;
    font-size: 13px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #c4d0de;
    text-decoration: none;
    padding: 13px 12px;
    transition: background-color 140ms var(--ease-out);
  }
  .menu__panel a:hover {
    background: var(--fl-wash);
    color: var(--fl-cream);
  }
  .menu__panel a[aria-current='page']:not(.menu__cta) {
    background: var(--fl-wash);
    color: var(--fl-cream);
    text-decoration: underline;
    text-decoration-color: var(--fl-orange);
    text-underline-offset: 5px;
    text-decoration-thickness: 2px;
  }
  /* Mismo destino primario que en desktop, con el mismo peso. Se escribe como
     `.menu__panel a.menu__cta` porque `.menu__panel a` es más específico que
     `.menu__cta` a secas y le ganaría el color. */
  .menu__panel a.menu__cta {
    margin-top: 6px;
    background: var(--fl-cream);
    color: var(--fl-navy);
    font-weight: 700;
    text-align: center;
  }
  .menu__panel a.menu__cta:hover {
    background: var(--fl-surface);
    color: var(--fl-navy);
  }
  .menu__panel a.menu__cta[aria-current='page'] {
    box-shadow: inset 0 -4px 0 var(--fl-orange);
  }

  /* Colapso: bajo 900px el nav inline se reemplaza por el disclosure. El corte
     subió de 860px porque el isotipo ensancha la marca. */
  @media (max-width: 899px) {
    .nav,
    .hd__rule {
      display: none;
    }
    .menu {
      display: block;
      margin-left: auto;
    }
  }
  /* Teléfonos: el isotipo mide ~2.2 anchos por alto, así que achicarlo por alto
     es lo que libera espacio para el wordmark y la hamburguesa. */
  @media (max-width: 480px) {
    .hd__inner {
      gap: 10px;
      padding: 0 16px;
    }
    .brand {
      gap: 10px;
    }
    .brand__iso {
      height: 30px;
    }
    .brand__word {
      font-size: 18px;
    }
  }
  @media (max-width: 360px) {
    .brand__iso {
      height: 26px;
    }
    .brand__word {
      font-size: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav a,
    .burger__bar,
    .burger__box::before,
    .burger__box::after,
    .menu__panel a {
      transition: none;
    }
  }
</style>
