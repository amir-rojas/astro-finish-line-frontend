---
// Ruta "/admin/login" — pantalla de acceso del panel admin
// (ver `sdd/admin-auth-surface-migration`, Fase 3). SSR: necesita leer los
// query params `?error` y `?email` en cada petición (los escribe el POST 303
// de `src/pages/api/admin/login.ts`, Fase 2).
//
// Diseño reescrito tras crítica de diseño (`/impeccable critique`): el
// split navy de dos columnas con wordmark gigante confundía "landing de
// marca" con "herramienta de trabajo diario". Ahora es una sola columna
// centrada, card blanca redondeada sobre fondo gris neutro (`--adm-bg`),
// una sola familia tipográfica y una única animación de entrada corta.
import AdminLayout from '@admin/layouts/AdminLayout.astro';
import AdminLoginForm from '@admin/features/auth/components/AdminLoginForm.astro';
import BrandIsotypeMono from '@admin/components/BrandIsotypeMono.astro';

export const prerender = false;

// Mensaje según lo que devolvió `/api/admin/login` — mapeo exacto del spec.
const ERROR_MESSAGES: Record<string, string> = {
  missing: 'Completa tu correo y contraseña.',
  invalid: 'Correo o contraseña incorrectos.',
  server: 'No pudimos conectar con el servidor. Intenta de nuevo.',
};
const errorCode = Astro.url.searchParams.get('error');
const errorMessage = errorCode ? (ERROR_MESSAGES[errorCode] ?? 'Ocurrió un error.') : null;

// Fix P1: repobla el email tras un error de login (nunca la contraseña).
const prefillEmail = Astro.url.searchParams.get('email') ?? '';
---

<AdminLayout title="Acceso administrativo">
  <main class="page">
    <header class="brand-head">
      <BrandIsotypeMono class="brand-icon" />
      <p class="wordmark">FINISH LINE</p>
      <p class="badge">Panel de administración</p>
    </header>

    <div class="card">
      <h1 class="title">Hola de nuevo</h1>
      <p class="subtitle">Ingresa para gestionar tus carreras e inscripciones.</p>

      {
        errorMessage && (
          <div class="alert" role="alert">
            <svg class="alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <line x1="12" y1="8" x2="12" y2="13" />
              <line x1="12" y1="16.5" x2="12" y2="16.51" />
            </svg>
            <span>{errorMessage}</span>
          </div>
        )
      }

      <AdminLoginForm email={prefillEmail} />
    </div>

    <p class="footnote">Acceso solo para organizadores.</p>

    <footer class="page-footer">© 2026 Finish Line Sporting Events · La Paz, Bolivia</footer>
  </main>
</AdminLayout>

<style>
  .page {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
    padding: clamp(24px, 6vw, 56px) 20px;
    background: var(--adm-bg);
  }

  /* ── cabecera de marca, chica y centrada ── */
  .brand-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .brand-icon {
    /* viewBox del isotipo es ancho (picos + corredor); se dimensiona por
       alto y el ancho sigue el aspect-ratio real del trazado. */
    height: 30px;
    width: auto;
    color: var(--adm-ink);
  }
  .wordmark {
    font-family: 'Barlow', sans-serif;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: var(--adm-ink);
  }
  .badge {
    display: inline-flex;
    align-items: center;
    background: var(--adm-surface);
    border: 1px solid var(--adm-border);
    border-radius: 999px;
    padding: 5px 14px;
    font-family: 'Barlow', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: var(--adm-muted);
  }

  /* ── card de login ── */
  .card {
    width: 100%;
    max-width: 440px;
    background: var(--adm-surface);
    border-radius: var(--adm-radius-card);
    box-shadow:
      0 1px 2px rgba(20, 33, 58, 0.04),
      0 16px 40px -12px rgba(20, 33, 58, 0.14);
    padding: clamp(28px, 5vw, 40px);
    animation: card-in 0.22s ease-out both;
  }
  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card {
      animation: none;
    }
  }

  .title {
    font-family: 'Barlow', sans-serif;
    font-size: clamp(26px, 4vw, 30px);
    font-weight: 700;
    color: var(--adm-ink);
    margin-bottom: 8px;
  }
  .subtitle {
    font-family: 'Barlow', sans-serif;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--adm-text);
    margin-bottom: 28px;
  }

  /* ── banner de error ── */
  .alert {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 24px;
    padding: 12px 16px;
    background: color-mix(in srgb, var(--adm-danger) 8%, white);
    border-radius: var(--adm-radius-control);
    font-family: 'Barlow', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: var(--adm-danger);
  }
  .alert-icon {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-top: 1px;
  }

  .footnote {
    font-family: 'Barlow', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: var(--adm-muted);
    text-align: center;
  }

  .page-footer {
    padding: 20px 0;
    text-align: center;
    font-family: 'Barlow', sans-serif;
    font-size: 12px;
    color: var(--adm-muted);
  }
</style>
