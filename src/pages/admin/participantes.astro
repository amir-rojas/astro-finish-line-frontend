---
// Ruta "/admin/participantes" — directorio de participantes (PR1 de
// `sdd/admin-reportes`, spec "admin-participants" + design "File Changes").
// Reemplaza el placeholder de `sdd/admin-dashboard` (D6) ahora que hay una
// pantalla real. Thin: `AdminShell` (SSR, sin JS) + `ParticipantsBrowser`
// (la única isla, ver ese componente) — mismo patrón que
// `inscripciones.astro`.
import AdminShell from '@admin/components/AdminShell.astro';
import ParticipantsBrowser from '@admin/features/participants/components/ParticipantsBrowser.astro';
import { ADMIN_NAV } from '@admin/components/nav';

export const prerender = false;

const label = ADMIN_NAV.find((item) => item.href === '/admin/participantes')!.label;
---

<AdminShell title={label}>
  <div class="page">
    <h1 class="page-title">{label}</h1>
    <p class="page-hint">Roster global de participantes, todas las carreras.</p>
    <ParticipantsBrowser />
  </div>
</AdminShell>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .page-title {
    font-family: 'Barlow', sans-serif;
    font-size: 22px;
    font-weight: 800;
    color: var(--adm-ink);
    margin: 0;
  }
  .page-hint {
    font-family: 'Barlow', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: var(--adm-muted);
    margin: 0 0 20px;
  }
</style>
