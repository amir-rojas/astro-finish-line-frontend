---
// Ruta "/admin/carreras" — placeholder (ver `sdd/admin-dashboard`, design D6
// + spec "Placeholder routes"). Thin: solo compone `AdminShell` + `ComingSoon`
// con el `label` del ítem correspondiente de `nav.ts`, fuente única.
import AdminShell from '@admin/components/AdminShell.astro';
import ComingSoon from '@admin/components/ComingSoon.astro';
import { ADMIN_NAV } from '@admin/components/nav';

export const prerender = false;

const label = ADMIN_NAV.find((item) => item.href === '/admin/carreras')!.label;
---

<AdminShell title={label}>
  <ComingSoon label={label} />
</AdminShell>
