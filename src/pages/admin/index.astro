---
// Ruta "/admin" — placeholder protegido del panel admin
// (ver `sdd/admin-auth-surface-migration`, Fase 3, spec "Admin Routes
// Require an Active Session"). El gate real vive en `src/middleware.ts`
// (corre para todo `/admin/*` salvo `/admin/login`): sin `session` ni
// `refresh_token` válidos redirige a `/admin/login` en silencio, sin aviso
// especial (decisión de negocio ya tomada); con `session` vencida pero
// `refresh_token` vivo, rota la sesión antes de llegar acá. Este archivo ya
// no repite ese chequeo — si se está renderizando, el middleware ya lo dejó
// pasar. Muestra un placeholder mínimo hasta que exista un dashboard real
// (fuera de alcance de este cambio).
import AdminLayout from '@admin/layouts/AdminLayout.astro';

export const prerender = false;
---

<AdminLayout title="Panel administrativo">
  <main class="dash">
    <p class="ok">Sesión iniciada correctamente.</p>
  </main>
</AdminLayout>

<style>
  .dash {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    font-family: 'Barlow', sans-serif;
    font-size: 1.1rem;
    color: var(--adm-ink);
  }
  .ok {
    font-weight: 600;
  }
</style>
