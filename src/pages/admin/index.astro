---
// Ruta "/admin" — dashboard del panel admin (ver `sdd/admin-dashboard`,
// spec "Dashboard content scope"). Reemplaza el placeholder mínimo de
// `sdd/admin-auth-surface-migration` ahora que hay un dashboard real. El gate
// de sesión sigue viviendo en `src/middleware.ts` (corre para todo
// `/admin/*` salvo `/admin/login`) — esta página no repite ese chequeo.
//
// Una sola llamada a `getEvents()`, envuelta en `safeBlock()` (design "Data
// Flow"): ambos bloques (`UpcomingRacesBlock`, `DeadlinesBlock`) comparten el
// MISMO resultado, así que un fallo de Sanity se ve una sola vez y ninguno de
// los dos hace su propio fetch. Sin barra de cupos, tarjeta de pagos, tabs de
// "requiere tu atención" ni indicador de sincronización (spec "Dashboard
// omits unbuilt widgets" — no hay fuente de datos verificada para ninguno).
import AdminShell from '@admin/components/AdminShell.astro';
import UpcomingRacesBlock from '@admin/features/dashboard/components/UpcomingRacesBlock.astro';
import DeadlinesBlock from '@admin/features/dashboard/components/DeadlinesBlock.astro';
import { safeBlock } from '@admin/lib/safe-block';
import { getEvents } from '@shared/lib/content/events';

export const prerender = false;

const eventsResult = await safeBlock(() => getEvents());
---

<AdminShell title="Dashboard">
  <div class="dashboard-grid">
    <UpcomingRacesBlock result={eventsResult} />
    <DeadlinesBlock result={eventsResult} />
  </div>
</AdminShell>

<style>
  .dashboard-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
  }
</style>
