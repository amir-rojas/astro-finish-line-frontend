---
// Ruta pública raíz "/" — la home (landing) del surface público.
// THIN: carga el evento destacado y orquesta las secciones del feature `home`.
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import PublicLayout from '@public/layouts/PublicLayout.astro';
import SiteHeader from '@public/components/SiteHeader.astro';
import Hero from '@public/features/home/sections/Hero.astro';
import RunTour from '@public/features/home/sections/RunTour.astro';
import Recaps from '@public/features/home/sections/Recaps.astro';
import Agenda from '@public/features/home/sections/Agenda.astro';
import SiteFooter from '@public/components/SiteFooter.astro';
import { eventJsonLd, seoTitle, upcomingByMonth } from '@public/features/home/format';
import { getNextRace, getEvents } from '@shared/lib/content/events';
import { pastRaces } from '@shared/lib/race-date';

// Fuente única: la próxima carrera (RaceEvent) gobierna el hero; se busca la
// MISMA entrada en la colección (EventData) para el SEO/OG/JSON-LD, que
// necesita campos ricos (city/country/organizer/price) que RaceEvent no trae.
// Antes había una selección DOBLE (evento `featured` para SEO + `getNextRace`
// para el hero) que podía describir dos carreras distintas (ver design ADR-6).
const nextRace = await getNextRace();
if (!nextRace) throw new Error('No hay carreras en la colección `events` para la home.');

const events = await getCollection('events');
const entry = events.find((e) => e.id === nextRace.slug);
if (!entry) throw new Error(`No se encontró la entrada de colección para el slug "${nextRace.slug}".`);
const event = entry.data;

// Agenda (Módulo 4): getEvents() no dispara un segundo fetch (ya no hay red,
// es local), pero se reusa la misma lista para no leer la colección dos veces.
const agendaMonths = upcomingByMonth(await getEvents(), new Date());
// El total gobierna la nota de cierre de la agenda: con una agenda flaca (≤2), la
// sección tiene que decir qué falta en vez de dejar al visitante contando filas.
const agendaTotal = agendaMonths.reduce((n, m) => n + m.races.length, 0);

// Recaps (Módulo 3): las carreras YA CORRIDAS, de la más reciente a la más vieja.
// Misma colección, misma regla que la agenda —`pastRaces` es la contraparte de
// `upcomingRaces`—, así que una carrera nunca puede estar en las dos listas ni
// caerse de ambas. Tope de 3: es una vitrina, no un archivo.
const recaps = pastRaces(await getEvents()).slice(0, 3);

// Imagen para compartir (Open Graph): render dedicado 1200×630 desde la foto
// del evento. Se pasa relativa al layout (que la vuelve absoluta) y absoluta
// al JSON-LD.
const ogImage = event.heroImage
  ? (await getImage({ src: event.heroImage, width: 1200, height: 630, format: 'jpeg' })).src
  : undefined;

const siteBase = Astro.site ?? Astro.url;
const ogImageAbsolute = ogImage ? new URL(ogImage, siteBase).href : undefined;

// Datos estructurados SportsEvent para rich results de Google.
const jsonLd = eventJsonLd(event, {
  url: Astro.url.href,
  image: ogImageAbsolute,
  organizerUrl: siteBase.href,
});
---

<PublicLayout title={seoTitle(event)} description={event.description} ogImage={ogImage}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  <SiteHeader />
  <main id="contenido">
    {/* El futuro antes del pasado. La agenda —lo único accionable de la home—
        estaba tras tres carreras ya corridas: quien llegaba buscando "cuándo es
        la próxima" y no era la del hero, tenía que atravesar la serie y los
        recaps para encontrarla. Recaps queda como cierre emocional, justo antes
        del footer, que es el mapa del sitio. */}
    <Hero race={nextRace} />
    <RunTour />
    <Agenda months={agendaMonths} total={agendaTotal} />
    <Recaps {recaps} />
  </main>
  <SiteFooter />
</PublicLayout>
