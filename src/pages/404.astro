---
// Página 404 del surface público. Astro (`output: 'static'`) y Vercel la sirven
// automáticamente para cualquier ruta que no matchee — no hace falta wirearla
// a mano en ningún lado.
import PublicLayout from '@public/layouts/PublicLayout.astro';
import SiteHeader from '@public/components/SiteHeader.astro';
---

<PublicLayout title="Página no encontrada" description="La página que buscas no existe o se movió.">
  <Fragment slot="head">
    {/* Nunca indexable: es una salida de error, no contenido que compita en búsqueda. */}
    <meta name="robots" content="noindex,nofollow" />
  </Fragment>
  <SiteHeader />
  <main id="contenido" class="nf">
    <div class="nf__inner">
      <p class="nf__kicker">// Error 404</p>
      <p class="nf__code">404</p>
      <h1 class="nf__title">Esta página no existe</h1>
      <p class="nf__copy">
        El enlace está roto o la página se movió. Prueba desde el inicio o revisa el calendario
        de carreras.
      </p>
      <div class="nf__actions">
        <a class="nf__cta" href="/">Ir al inicio</a>
        <a class="nf__cta nf__cta--ghost" href="/calendario">Ver el calendario</a>
      </div>
    </div>
  </main>
</PublicLayout>

<style>
  .nf {
    background: var(--fl-navy);
    display: grid;
    place-items: center;
    min-height: calc(100vh - var(--fl-header-h, 74px));
    min-height: calc(100dvh - var(--fl-header-h, 74px));
  }
  .nf__inner {
    max-width: 640px;
    margin: 0 auto;
    padding: clamp(56px, 9vw, 96px) clamp(20px, 5vw, 56px);
    text-align: center;
  }
  .nf__kicker {
    margin: 0 0 clamp(16px, 2.4vw, 22px);
    font-family: 'Space Mono', monospace;
    font-size: clamp(13px, 1.8vw, 15px);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--fl-on-navy-muted);
  }
  .nf__code {
    margin: 0;
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(72px, 14vw, 160px);
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--fl-orange);
  }
  .nf__title {
    margin: clamp(12px, 2vw, 18px) 0 0;
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(22px, 3vw, 32px);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--fl-cream);
  }
  .nf__copy {
    margin: clamp(14px, 2vw, 18px) 0 0;
    font-size: clamp(15px, 1.8vw, 17px);
    color: var(--fl-on-navy-soft);
  }
  .nf__actions {
    margin-top: clamp(28px, 4vw, 36px);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }
  .nf__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--fl-orange-strong);
    color: #fff;
    font-family: 'Space Mono', monospace;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    padding: 15px 26px;
    transition: background 160ms var(--ease-out);
  }
  .nf__cta--ghost {
    background: transparent;
    color: var(--fl-cream);
    border: 1px solid var(--fl-edge);
  }
  @media (hover: hover) {
    .nf__cta:hover {
      background: var(--fl-orange-hover);
    }
    .nf__cta--ghost:hover {
      background: var(--fl-wash);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nf__cta {
      transition: none;
    }
  }
</style>
