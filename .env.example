# Backend Go — BFF server-side only. Not a secret.
BACKEND_URL=http://localhost:8080

# Shared secret BFF<->Go. Sent as X-Service-Secret on every server-side call to
# {BACKEND_URL}/api/v1/*. MUST match Go's SERVICE_SECRET or Go answers 401.
BACKEND_SERVICE_SECRET=

# RESERVED — not used yet. The Go access_token is the session source of truth
# (stored as-is in the httpOnly `session` cookie). Declared for a future
# signed/encrypted-cookie iteration. Absent = fine (optional, no default).
SESSION_SECRET=

# PARKED — Strapi no longer feeds any build (race content lives in
# src/content/events/*.json). Declared only so strapi-client.ts keeps
# type-checking under astro:env/server. Nothing reads these at runtime.
STRAPI_URL=http://localhost:1337
STRAPI_TOKEN=
