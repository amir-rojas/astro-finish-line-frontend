# URL base del backend (lo consume el BFF server-side). No es secreto.
BACKEND_URL="http://localhost:8080"
# Secreto para firmar la cookie de sesión admin. NO commitear el valor real.
SESSION_SECRET=""

# CMS de carreras. En dev, el Strapi local.
# En staging/prod: la URL PÚBLICA y https del Strapi desplegado.
# De acá sale también el host permitido para optimizar imágenes (astro.config.mjs).
STRAPI_URL=http://localhost:1337
# Token de API de Strapi (lectura de contenido publicado). Sin default:
# si falta, el build se corta a propósito (no publica carreras con datos rotos).
STRAPI_TOKEN=""